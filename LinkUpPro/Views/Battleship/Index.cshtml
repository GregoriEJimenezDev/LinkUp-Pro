@using LinkUpPro.Core.Domain.Enum
@using LinkUpPro.Core.Application.DTOs.Battleship
@using System.Security.Claims
@model LinkUpPro.Core.Application.ViewModel.Game.BattleshipIndexViewModel

@{
    ViewData["Title"] = "Battleship";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    
    // Separate invitations from active games
    var pendingInvitations = Model.ActiveGames
        .Where(g => g.Status == GameStatus.WaitingForOpponent && g.Player2Id == currentUserId)
        .ToList();
        
    var activeGames = Model.ActiveGames
        .Except(pendingInvitations)
        .ToList();
}

<div class="flex flex-col gap-8 w-full max-w-4xl mx-auto animate-in fade-in slide-in-from-bottom-4 duration-500">
    <!-- Encabezado -->
    <div class="flex items-center justify-between rounded-xl bg-card border shadow-sm p-6">
        <div class="flex flex-col gap-1">
            <h1 class="text-2xl font-bold tracking-tight flex items-center gap-2">
                <i data-lucide="gamepad-2" class="size-6 text-primary"></i>
                Batallas
            </h1>
            <p class="text-sm text-muted-foreground">Juega Battleship con tus amigos</p>
        </div>
        <a href="/Battleship/Create" class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2 rounded-md shadow-sm gap-2">
            <i data-lucide="plus" class="size-4"></i>
            Nueva Partida
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="rounded-xl border border-destructive/50 bg-destructive/10 px-4 py-3 text-sm text-destructive">
            @TempData["Error"]
        </div>
    }

    <!-- Invitaciones pendientes -->
    @if (pendingInvitations.Any())
    {
        <div class="flex flex-col gap-3">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">Invitaciones pendientes (@pendingInvitations.Count)</h2>
            <div class="grid gap-3">
                @foreach (var game in pendingInvitations)
                {
                    <div class="flex items-center justify-between rounded-lg border bg-card p-4 shadow-sm">
                        <div class="flex items-center gap-3">
                            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/10">
                                <i data-lucide="swords" class="size-5 text-primary"></i>
                            </div>
                            <p class="text-sm font-medium"><span class="font-bold text-foreground">@game.Player1Username</span> te invitó a jugar</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <a href="/Battleship/SelectShip?gameId=@game.Id" class="inline-flex items-center justify-center h-8 px-3 rounded-md bg-primary text-primary-foreground text-xs font-medium hover:bg-primary/90 transition-colors">
                                Aceptar
                            </a>
                            <form asp-action="Reject" method="post" class="m-0">
                                <input type="hidden" name="gameId" value="@game.Id" />
                                <button type="submit" class="inline-flex items-center justify-center h-8 px-3 rounded-md bg-secondary text-secondary-foreground text-xs font-medium hover:bg-secondary/80 transition-colors">
                                    Rechazar
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="grid gap-8 md:grid-cols-[2fr_1fr]">
        <!-- Partidas Activas -->
        <div class="flex flex-col gap-3">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">Partidas activas</h2>
            
            <div class="flex flex-col gap-3">
                @if (activeGames.Any())
                {
                    foreach (var game in activeGames)
                    {
                        var opponentUsername = game.Player1Id == currentUserId ? game.Player2Username : game.Player1Username;
                        var isMyTurn = game.CurrentTurnPlayerId == currentUserId;
                        
                        <div class="flex items-center justify-between rounded-lg border bg-card p-4 hover:bg-accent/50 transition-colors">
                            <div class="flex items-center gap-3">
                                <div class="relative flex size-10 shrink-0 overflow-hidden rounded-full border border-border bg-secondary">
                                    <i data-lucide="user" class="size-5 m-auto text-muted-foreground"></i>
                                </div>
                                <div class="flex flex-col">
                                    <span class="text-sm font-semibold">vs @opponentUsername</span>
                                    
                                    @if (game.Status == GameStatus.WaitingForOpponent)
                                    {
                                        <span class="text-xs text-muted-foreground">Esperando que acepte...</span>
                                    }
                                    else if (game.Status == GameStatus.PlacingShips)
                                    {
                                        <span class="text-xs text-yellow-500 font-medium">Fase de preparación</span>
                                    }
                                    else
                                    {
                                        if (isMyTurn)
                                        {
                                            <span class="text-xs text-primary font-medium flex items-center gap-1"><i data-lucide="play" class="size-3 fill-current"></i> Tu turno</span>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-muted-foreground">Esperando al rival</span>
                                        }
                                    }
                                </div>
                            </div>

                            @if (game.Status == GameStatus.PlacingShips || (game.Status == GameStatus.WaitingForOpponent && game.Player1Id == currentUserId))
                            {
                                <a href="/Battleship/SelectShip?gameId=@game.Id" class="inline-flex h-8 items-center justify-center rounded-md bg-secondary px-3 text-xs font-medium hover:bg-secondary/80">
                                    @(game.Status == GameStatus.WaitingForOpponent ? "Ver sala" : "Preparar")
                                </a>
                            }
                            else
                            {
                                <a href="/Battleship/AttackBoard?gameId=@game.Id" class="inline-flex h-8 items-center justify-center rounded-md @(isMyTurn ? "bg-primary text-primary-foreground hover:bg-primary/90" : "bg-secondary text-secondary-foreground hover:bg-secondary/80") px-3 text-xs font-medium">
                                    @(isMyTurn ? "Continuar" : "Ver partida")
                                </a>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="flex flex-col items-center justify-center rounded-lg border border-dashed py-8 text-center text-sm text-muted-foreground">
                        No hay partidas activas.
                    </div>
                }
            </div>
        </div>

        <!-- Historial reciente -->
        <div class="flex flex-col gap-3">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">Historial reciente</h2>
            
            <div class="flex flex-col gap-2">
                @if (Model.FinishedGames.Any())
                {
                    foreach (var game in Model.FinishedGames.Take(6))
                    {
                        var opponentUsername = game.Player1Id == currentUserId ? game.Player2Username : game.Player1Username;
                        var isWinner = game.WinnerId == currentUserId;
                        var isAbandoned = game.Status == GameStatus.Abandoned;
                        
                        <a href="/Battleship/Result?gameId=@game.Id" class="flex items-center justify-between rounded-lg border bg-card p-3 hover:bg-accent/50 transition-colors">
                            <span class="text-sm font-medium flex items-center gap-2">
                                @if (isAbandoned)
                                {
                                    <span>🏳️ vs @opponentUsername</span>
                                }
                                else if (isWinner)
                                {
                                    <span>🏆 vs @opponentUsername</span>
                                }
                                else
                                {
                                    <span>❌ vs @opponentUsername</span>
                                }
                            </span>
                            <i data-lucide="chevron-right" class="size-4 text-muted-foreground"></i>
                        </a>
                    }
                }
                else
                {
                    <div class="text-sm text-muted-foreground py-4 text-center">Sin historial.</div>
                }
            </div>
        </div>
    </div>
</div>
