@model LinkUpPro.Core.Application.ViewModel.Game.GameResultViewModel

@{
    ViewData["Title"] = "Resultado de Partida";
    
    var duration = Model.FinishedAt.HasValue 
        ? Model.FinishedAt.Value.Subtract(Model.StartedAt) 
        : TimeSpan.Zero;
        
    string durationStr = duration.TotalHours >= 1 
        ? $"{(int)duration.TotalHours} h {duration.Minutes:00} min" 
        : $"{(int)duration.TotalMinutes} min {duration.Seconds:00} s";
}

<div class="flex flex-col gap-6 w-full max-w-xl mx-auto animate-in fade-in slide-in-from-bottom-4 duration-500">
    <div class="flex flex-col overflow-hidden rounded-xl border bg-card shadow-sm">
        
        <!-- Header -->
        <div class="flex items-center justify-between border-b bg-muted/30 px-6 py-4">
            <h1 class="text-lg font-bold tracking-tight text-foreground flex items-center gap-2">
                <i data-lucide="flag-checkered" class="size-5 text-muted-foreground"></i> Partida Finalizada
            </h1>
        </div>

        <!-- Contenido Central -->
        <div class="flex flex-col p-6">
            <div class="flex items-center gap-4 mb-8 p-4 rounded-lg @(Model.IWon ? "bg-success/10 border border-success/20" : "bg-destructive/10 border border-destructive/20")">
                <div class="flex size-14 shrink-0 items-center justify-center rounded-full @(Model.IWon ? "bg-success/20" : "bg-destructive/20")">
                    @if (Model.IWon)
                    {
                        <i data-lucide="trophy" class="size-7 text-success"></i>
                    }
                    else
                    {
                        <i data-lucide="skull" class="size-7 text-destructive"></i>
                    }
                </div>
                <div class="flex flex-col">
                    <h2 class="text-2xl font-black uppercase tracking-wider @(Model.IWon ? "text-success" : "text-destructive")">
                        @(Model.IWon ? "¡Has Ganado!" : "Derrota")
                    </h2>
                    <p class="text-sm text-muted-foreground">
                        @if (Model.WonBySurrender)
                        {
                            @("El rival se ha rendido.")
                        }
                        else if (Model.LostBySurrender)
                        {
                            @("Te has rendido.")
                        }
                        else
                        {
                            @(Model.IWon ? "Destruiste la flota enemiga." : "Tu flota fue hundida.")
                        }
                    </p>
                </div>
            </div>

            <div class="flex flex-col gap-1 rounded-lg border bg-secondary/20 p-4">
                <div class="flex items-center justify-between py-2 border-b border-border/50">
                    <span class="text-sm text-muted-foreground">Rival</span>
                    <span class="text-sm font-semibold">@Model.OpponentUsername</span>
                </div>
                <div class="flex items-center justify-between py-2 border-b border-border/50">
                    <span class="text-sm text-muted-foreground">Duración</span>
                    <span class="text-sm font-semibold">@durationStr</span>
                </div>
                <div class="flex items-center justify-between py-2 border-b border-border/50">
                    <span class="text-sm text-muted-foreground">Movimientos</span>
                    <span class="text-sm font-semibold">@Model.MyAttacks.Count</span>
                </div>
                <div class="flex items-center justify-between py-2 border-b border-border/50">
                    <span class="text-sm text-muted-foreground">Barcos hundidos</span>
                    <span class="text-sm font-semibold text-destructive">@Model.EnemyShipsSunk / 5</span>
                </div>
                <div class="flex items-center justify-between py-2">
                    <span class="text-sm text-muted-foreground">Fecha</span>
                    <span class="text-sm font-semibold">@Model.FinishedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>
        </div>
        
        <!-- Acciones -->
        <div class="flex flex-col sm:flex-row gap-3 bg-muted/30 p-6 border-t mt-auto">
            <a href="/Battleship/Index" class="inline-flex flex-1 items-center justify-center whitespace-nowrap text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 rounded-md shadow-sm">
                Volver a Batallas
            </a>
            <a href="/Battleship/AttackBoard?gameId=@Model.GameId" class="inline-flex flex-1 items-center justify-center whitespace-nowrap text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 rounded-md shadow-sm">
                Ver tableros finales
            </a>
        </div>
        
    </div>
</div>
