@using LinkUpPro.Core.Application.DTOs.Friend
@model List<FriendDto>

@{
    ViewData["Title"] = "Nueva partida";
}

<div class="flex flex-col gap-6 w-full max-w-2xl mx-auto animate-in fade-in slide-in-from-bottom-4 duration-500">
    <!-- Header -->
    <div class="flex items-center gap-4 border-b pb-4">
        <a href="/Battleship/Index" class="inline-flex items-center justify-center rounded-full bg-secondary h-10 w-10 text-muted-foreground hover:text-foreground hover:bg-secondary/80 transition-colors">
            <i data-lucide="arrow-left" class="size-5"></i>
        </a>
        <div class="flex flex-col">
            <h1 class="text-2xl font-bold tracking-tight text-foreground">Nueva Partida</h1>
            <p class="text-sm text-muted-foreground">Selecciona a un amigo para enviarle un desafío</p>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="rounded-xl border border-destructive/50 bg-destructive/10 px-4 py-3 text-sm text-destructive">
            @TempData["Error"]
        </div>
    }

    <div class="flex flex-col gap-4">
        @if (Model != null && Model.Any())
        {
            <!-- Buscador -->
            <div class="relative">
                <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 size-4 text-muted-foreground"></i>
                <input type="text" id="friendSearch" placeholder="Buscar amigo..." class="flex h-11 w-full rounded-md border border-input bg-card pl-9 pr-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" />
            </div>

            <!-- Lista de Amigos -->
            <form asp-action="Create" method="post" class="rounded-xl border bg-card overflow-hidden">
                <div class="flex flex-col divide-y divide-border" id="friendList">
                    @foreach (var friend in Model)
                    {
                        <label class="friend-item flex items-center justify-between p-4 transition-colors hover:bg-accent/50 cursor-pointer">
                            <div class="flex items-center gap-3">
                                <div class="relative flex size-10 shrink-0 overflow-hidden rounded-full border border-border">
                                    <img class="aspect-square h-full w-full object-cover" src="@friend.ProfilePicture" alt="@friend.Username" onerror="this.src='/placeholder.svg'" />
                                </div>
                                <div class="flex flex-col">
                                    <span class="text-sm font-semibold friend-name">@friend.FullName</span>
                                    <span class="text-xs text-muted-foreground friend-username">@@@friend.Username</span>
                                </div>
                            </div>
                            
                            <div class="flex items-center">
                                <input type="radio" name="friendId" value="@friend.UserId" class="size-4 text-primary bg-background border-border focus:ring-primary focus:ring-offset-background" required />
                            </div>
                        </label>
                    }
                </div>
                
                <div class="p-4 border-t bg-muted/20 flex justify-end">
                    <button type="submit" class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-6 rounded-md shadow-sm">
                        Invitar a Jugar
                    </button>
                </div>
                
                <div id="noResults" class="hidden flex-col items-center justify-center p-8 text-center text-sm text-muted-foreground">
                    <i data-lucide="search-x" class="mb-2 size-8 opacity-20"></i>
                    <p>No se encontraron amigos.</p>
                </div>
            </form>
        }
        else
        {
            <div class="flex flex-col items-center justify-center rounded-2xl border border-dashed p-8 text-center text-sm text-muted-foreground">
                <i data-lucide="users" class="mb-3 size-8 opacity-20"></i>
                <p class="font-medium text-foreground">No tienes amigos agregados</p>
                <p class="mt-1 max-w-sm">Para jugar Battleship, necesitas agregar amigos a tu lista primero.</p>
                <a href="/Friendship/Index" class="mt-4 rounded-md bg-secondary px-4 py-2 text-xs font-medium text-foreground hover:bg-secondary/80 transition-colors">
                    Buscar amigos
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/battleship-create.js" asp-append-version="true"></script>
}
