@model IEnumerable<FriendDto>
@{
    ViewData["Title"] = "New Battle";
}

<div class="container mt-4">
    <h1 class="display-6 mb-4">New Battle</h1>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <p class="text-muted fs-5">You have no friends yet. Add friends to play Battleship!</p>
            <a asp-controller="Friend" asp-action="Index" class="btn btn-primary">Find Friends</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var friend in Model)
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body text-center">
                            <div class="mb-3">
                                @if (!string.IsNullOrEmpty(friend.ProfilePicture))
                                {
                                    <img src="@friend.ProfilePicture" alt="@friend.Username" class="rounded-circle" width="80" height="80" style="object-fit:cover" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-secondary d-inline-flex align-items-center justify-content-center text-white" style="width:80px;height:80px;font-size:2rem">
                                        @friend.Username[0]
                                    </div>
                                }
                            </div>
                            <h5 class="card-title">@friend.FullName</h5>
                            <p class="text-muted">@@@friend.Username</p>
                            <form asp-action="Create" method="post">
                                <input type="hidden" name="friendId" value="@friend.UserId" />
                                <button type="submit" class="btn btn-primary w-100">Challenge!</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>
