@using LinkUpPro.Core.Application.DTOs.Battleship
@model LinkUpPro.Core.Application.ViewModel.Game.AttackBoardViewModel

@{
    ViewData["Title"] = "Tablero de Combate";
    
    // Diccionarios para acceso rápido
    var myAttacks = new Dictionary<string, bool>(); // Row,Col -> IsHit
    if (Model.MyAttacks != null)
    {
        foreach (var attack in Model.MyAttacks)
        {
            myAttacks[$"{attack.Row},{attack.Column}"] = attack.IsHit;
        }
    }

    var oppAttacks = new Dictionary<string, bool>();
    if (Model.OpponentAttacks != null)
    {
        foreach (var attack in Model.OpponentAttacks)
        {
            oppAttacks[$"{attack.Row},{attack.Column}"] = attack.IsHit;
        }
    }

    var myShipsCells = new HashSet<string>();
    var sunkCells = new HashSet<string>();
    if (Model.MyShips != null)
    {
        foreach (var ship in Model.MyShips)
        {
            foreach (var cell in ship.Cells)
            {
                var key = $"{cell.Row},{cell.Column}";
                myShipsCells.Add(key);
                if (ship.IsSunk)
                {
                    sunkCells.Add(key);
                }
            }
        }
    }

    string[] cols = { "A", "B", "C", "D", "E", "F", "G", "H" };
    
    // Obtener el último movimiento para el log
    string lastMove = "Esperando el primer ataque...";
    if (Model.MyAttacks != null && Model.MyAttacks.Any() && Model.OpponentAttacks != null)
    {
        var allAttacks = Model.MyAttacks.Select(a => new { ByMe = true, Attack = a })
            .Concat(Model.OpponentAttacks.Select(a => new { ByMe = false, Attack = a }))
            .OrderByDescending(x => x.Attack.Id) // Id assuming it's sequential or has a Date (we don't have Date in DTO but we can use list order as latest)
            .FirstOrDefault();
            
        // actually in lists they are usually returned ordered or we can just pick the last in the array.
        // wait, we don't have Attack.Id in DTO? Let's just use the last element.
        var myLast = Model.MyAttacks.LastOrDefault();
        var oppLast = Model.OpponentAttacks.LastOrDefault();
        // Since we can't reliably know who attacked last without timestamps, 
        // we can just say "Último ataque tuyo: X" y "Último ataque rival: Y"
    }
}

<div class="flex flex-col gap-6 w-full max-w-5xl mx-auto animate-in fade-in slide-in-from-bottom-4 duration-500">
    <!-- Encabezado -->
    <div class="flex items-center justify-between rounded-xl bg-card border shadow-sm p-6">
        <div class="flex items-center gap-4">
            <a href="/Battleship/Index" class="inline-flex items-center justify-center rounded-full bg-secondary h-10 w-10 text-muted-foreground hover:text-foreground hover:bg-secondary/80 transition-colors">
                <i data-lucide="arrow-left" class="size-5"></i>
            </a>
            <div class="flex flex-col">
                <h1 class="text-2xl font-bold tracking-tight flex items-center gap-2">
                    <i data-lucide="crosshair" class="size-6 text-primary"></i>
                    Batalla contra @Model.OpponentUsername
                </h1>
                <div class="flex items-center gap-2 mt-1">
                    <span class="text-sm font-medium text-muted-foreground">Estado:</span>
                    @if (Model.IsMyTurn)
                    {
                        <span class="rounded-md bg-primary/20 px-2 py-0.5 text-xs font-semibold text-primary animate-pulse border border-primary/30">
                            ¡Tu turno!
                        </span>
                    }
                    else
                    {
                        <span class="rounded-md bg-secondary px-2 py-0.5 text-xs font-semibold text-muted-foreground">
                            Esperando maniobra enemiga
                        </span>
                    }
                </div>
            </div>
        </div>
        
        <div class="flex items-center gap-3">
            @if (!Model.IsMyTurn)
            {
                <button type="button" onclick="window.location.reload()" class="inline-flex h-10 items-center justify-center rounded-md bg-secondary px-4 text-sm font-medium hover:bg-secondary/80 transition-colors gap-2">
                    <i data-lucide="refresh-cw" class="size-4"></i>
                    Actualizar estado
                </button>
            }
            <form asp-action="Surrender" method="post" class="m-0">
                <input type="hidden" name="gameId" value="@Model.GameId" />
                <button type="submit" class="inline-flex h-10 items-center justify-center rounded-md border border-destructive bg-transparent px-4 text-sm font-medium text-destructive hover:bg-destructive hover:text-destructive-foreground transition-colors gap-2" onclick="return confirm('¿Estás seguro de que quieres rendirte?');">
                    <i data-lucide="flag-triangle-right" class="size-4"></i>
                    Rendirse
                </button>
            </form>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="rounded-xl border border-destructive/50 bg-destructive/10 px-4 py-3 text-sm text-destructive">
            @TempData["Error"]
        </div>
    }

    <!-- Contenedor Principal (2 Tableros) -->
    <div class="grid gap-8 lg:grid-cols-2">
        
        <!-- TU TABLERO -->
        <div class="flex flex-col gap-4 rounded-xl border bg-card p-6 shadow-sm">
            <h2 class="text-center font-bold tracking-widest text-muted-foreground uppercase text-sm mb-2 flex items-center justify-center gap-2">
                <i data-lucide="shield-half" class="size-4"></i> Tu Tablero
            </h2>
            
            <div class="mx-auto grid grid-cols-[auto_1fr] gap-2">
                <div class="flex flex-col gap-1 pr-2 pt-6">
                    @for (int r = 1; r <= 8; r++)
                    {
                        <div class="flex size-8 sm:size-10 items-center justify-center text-xs font-semibold text-muted-foreground">@r</div>
                    }
                </div>
                <div class="flex flex-col gap-1">
                    <div class="grid grid-cols-8 gap-1">
                        @foreach (var c in cols)
                        {
                            <div class="flex h-6 items-center justify-center text-xs font-semibold text-muted-foreground">@c</div>
                        }
                    </div>
                    <div class="grid grid-cols-8 gap-1 bg-border/50 p-1 rounded-lg">
                        @for (int r = 0; r < 8; r++)
                        {
                            for (int c = 0; c < 8; c++)
                            {
                                string key = $"{r},{c}";
                                bool isMyShip = myShipsCells.Contains(key);
                                bool isSunk = sunkCells.Contains(key);
                                bool hasBeenAttacked = oppAttacks.ContainsKey(key);
                                
                                string cellClass = "bg-secondary"; // Agua normal (niebla)
                                if (hasBeenAttacked)
                                {
                                    if (isMyShip)
                                    {
                                        cellClass = isSunk ? "bg-destructive border-destructive" : "bg-destructive/60 border-destructive/80";
                                    }
                                    else
                                    {
                                        cellClass = "bg-primary/20 border border-primary/30"; // Agua disparada
                                    }
                                }
                                else if (isMyShip)
                                {
                                    cellClass = "bg-accent border border-muted-foreground/30"; // Barco intacto
                                }

                                <div class="size-8 sm:size-10 rounded-sm transition-all flex items-center justify-center text-xs @cellClass">
                                    @if (hasBeenAttacked && isMyShip)
                                    {
                                        <i data-lucide="flame" class="size-4 @(isSunk ? "text-white" : "text-destructive-foreground")"></i>
                                    }
                                    else if (hasBeenAttacked && !isMyShip)
                                    {
                                        <div class="size-1.5 rounded-full bg-primary/50"></div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- TABLERO ENEMIGO -->
        <div class="flex flex-col gap-4 rounded-xl border bg-card p-6 shadow-sm relative overflow-hidden">
            <h2 class="text-center font-bold tracking-widest text-primary uppercase text-sm mb-2 flex items-center justify-center gap-2">
                <i data-lucide="swords" class="size-4"></i> Tablero Enemigo
            </h2>
            
            @if (!Model.IsMyTurn)
            {
                <div class="absolute inset-0 bg-background/50 backdrop-blur-[2px] z-10 flex flex-col items-center justify-center">
                    <i data-lucide="radar" class="size-10 text-primary animate-spin opacity-60 mb-3"></i>
                    <p class="font-semibold text-lg drop-shadow-md">Esperando turno</p>
                </div>
            }

            <div class="mx-auto grid grid-cols-[auto_1fr] gap-2">
                <div class="flex flex-col gap-1 pr-2 pt-6">
                    @for (int r = 1; r <= 8; r++)
                    {
                        <div class="flex size-8 sm:size-10 items-center justify-center text-xs font-semibold text-muted-foreground">@r</div>
                    }
                </div>
                <div class="flex flex-col gap-1">
                    <div class="grid grid-cols-8 gap-1">
                        @foreach (var c in cols)
                        {
                            <div class="flex h-6 items-center justify-center text-xs font-semibold text-muted-foreground">@c</div>
                        }
                    </div>
                    <div class="grid grid-cols-8 gap-1 bg-border/50 p-1 rounded-lg">
                        @for (int r = 0; r < 8; r++)
                        {
                            for (int c = 0; c < 8; c++)
                            {
                                string key = $"{r},{c}";
                                bool hasAttacked = myAttacks.ContainsKey(key);
                                bool isHit = hasAttacked && myAttacks[key];

                                if (hasAttacked)
                                {
                                    <div class="size-8 sm:size-10 rounded-sm flex items-center justify-center @(isHit ? "bg-destructive border-destructive" : "bg-primary/20 border border-primary/30")">
                                        @if (isHit)
                                        {
                                            <i data-lucide="flame" class="size-4 text-white"></i>
                                        }
                                        else
                                        {
                                            <div class="size-1.5 rounded-full bg-primary/50"></div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <button type="button" 
                                            onclick="attackCell(@r, @c)"
                                            @(Model.IsMyTurn ? "" : "disabled")
                                            class="size-8 sm:size-10 rounded-sm transition-all flex items-center justify-center bg-secondary hover:bg-primary/40 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
                                    </button>
                                }
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
        
    </div>

    <!-- Leyenda y Registro -->
    <div class="flex flex-col sm:flex-row gap-6 bg-card rounded-xl border p-4 shadow-sm items-center justify-between">
        <div class="flex items-center gap-6 text-sm">
            <span class="font-semibold text-muted-foreground">Leyenda:</span>
            <div class="flex items-center gap-2">
                <div class="size-5 rounded-sm bg-accent border border-muted-foreground/30"></div>
                <span class="text-muted-foreground text-xs">Barco propio</span>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-5 rounded-sm bg-destructive flex items-center justify-center"><i data-lucide="flame" class="size-3 text-white"></i></div>
                <span class="text-muted-foreground text-xs">Impacto</span>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-5 rounded-sm bg-primary/20 flex items-center justify-center"><div class="size-1 rounded-full bg-primary/50"></div></div>
                <span class="text-muted-foreground text-xs">Agua</span>
            </div>
        </div>
        
        <div class="text-sm font-mono text-muted-foreground">
            @if(Model.MyAttacks != null && Model.MyAttacks.Any())
            {
                var last = Model.MyAttacks.Last();
                <span>Tu último disparo: @cols[last.Column]@(last.Row + 1) (@(last.IsHit ? "Impacto" : "Agua"))</span>
            }
        </div>
    </div>
</div>

<form id="attackForm" asp-action="Attack" method="post" class="hidden">
    <input type="hidden" name="gameId" value="@Model.GameId" />
    <input type="hidden" id="attackRow" name="row" value="" />
    <input type="hidden" id="attackCol" name="col" value="" />
</form>

@section Scripts {
    <script>
        function attackCell(row, col) {
            document.getElementById('attackRow').value = row;
            document.getElementById('attackCol').value = col;
            document.getElementById('attackForm').submit();
        }
        
        @if (!Model.IsMyTurn)
        {
            <text>
            // Recarga amigable cada 15s si el usuario prefiere no apretar el botón
            setTimeout(() => {
                window.location.reload();
            }, 15000);
            </text>
        }
    </script>
}
