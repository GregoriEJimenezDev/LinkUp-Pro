@using LinkUpPro.Core.Application.DTOs.Battleship
@model LinkUpPro.Core.Application.ViewModel.Game.AttackBoardViewModel

@{
    ViewData["Title"] = "Tablero de Combate";
    
    // Crear diccionario de ataques para búsqueda rápida
    var attacks = new Dictionary<string, bool>();
    if (Model.MyAttacks != null)
    {
        foreach (var attack in Model.MyAttacks)
        {
            attacks[$"{attack.Row},{attack.Column}"] = attack.IsHit;
        }
    }
}

<div class="flex flex-col gap-6 w-full max-w-3xl mx-auto animate-in fade-in slide-in-from-bottom-4 duration-500">
    <div class="flex items-center gap-4">
        <a href="/Battleship/Index" class="inline-flex items-center justify-center rounded-full bg-secondary h-10 w-10 text-muted-foreground hover:text-foreground hover:bg-secondary/80 transition-colors">
            <i data-lucide="arrow-left" class="size-5"></i>
        </a>
        <div class="flex flex-col flex-1">
            <div class="flex items-center justify-between">
                <h1 class="text-2xl font-bold tracking-tight text-foreground">Combate en curso</h1>
                @if (Model.IsMyTurn)
                {
                    <span class="rounded-full bg-primary/20 px-3 py-1 text-xs font-semibold text-primary animate-pulse border border-primary/30">¡Tu turno!</span>
                }
                else
                {
                    <span class="rounded-full bg-secondary px-3 py-1 text-xs font-semibold text-muted-foreground">Turno de @Model.CurrentTurnUsername</span>
                }
            </div>
            <p class="text-sm text-muted-foreground">Atacando la flota de <span class="font-semibold text-foreground">@Model.OpponentUsername</span></p>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="rounded-xl border border-destructive/50 bg-destructive/10 px-4 py-3 text-sm text-destructive flex items-center gap-2">
            <i data-lucide="alert-circle" class="size-4"></i>
            @TempData["Error"]
        </div>
    }

    <!-- Tablero de Ataque -->
    <div class="flex flex-col items-center justify-center rounded-2xl border bg-card p-6 shadow-sm relative overflow-hidden">
        
        @if (!Model.IsMyTurn)
        {
            <div class="absolute inset-0 bg-background/50 backdrop-blur-sm z-10 flex flex-col items-center justify-center">
                <i data-lucide="radar" class="size-12 text-primary animate-spin opacity-50 mb-4"></i>
                <p class="font-semibold text-lg">Esperando maniobra enemiga</p>
                <p class="text-sm text-muted-foreground mt-1">El oponente está planeando su ataque...</p>
                
                <button type="button" onclick="window.location.reload()" class="mt-6 inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-colors bg-secondary text-foreground hover:bg-secondary/80 h-9 px-4 rounded-full gap-2">
                    <i data-lucide="refresh-cw" class="size-3"></i> Actualizar estado
                </button>
            </div>
        }

        <div class="grid grid-cols-8 gap-1 bg-secondary/30 p-2 rounded-xl relative z-0">
            @for (int r = 0; r < 8; r++)
            {
                for (int c = 0; c < 8; c++)
                {
                    string key = $"{r},{c}";
                    bool hasAttacked = attacks.ContainsKey(key);
                    bool isHit = hasAttacked && attacks[key];

                    if (hasAttacked)
                    {
                        <div class="size-10 md:size-12 flex items-center justify-center rounded-md @(isHit ? "bg-destructive/20 border border-destructive/50" : "bg-primary/10 border border-primary/20")">
                            @if (isHit)
                            {
                                <i data-lucide="flame" class="size-5 text-destructive"></i>
                            }
                            else
                            {
                                <div class="size-2 rounded-full bg-primary/40"></div>
                            }
                        </div>
                    }
                    else
                    {
                        <button type="button" 
                                onclick="attackCell(@r, @c)"
                                @(Model.IsMyTurn ? "" : "disabled")
                                class="size-10 md:size-12 rounded-md transition-all flex items-center justify-center text-xs bg-secondary/50 hover:bg-primary/20 hover:scale-105 active:scale-95 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
                        </button>
                    }
                }
            }
        </div>
        
        <div class="flex items-center gap-6 mt-6 text-sm">
            <div class="flex items-center gap-2">
                <div class="size-6 rounded-md bg-destructive/20 border border-destructive/50 flex items-center justify-center"><i data-lucide="flame" class="size-3 text-destructive"></i></div>
                <span class="text-muted-foreground">Impacto</span>
            </div>
            <div class="flex items-center gap-2">
                <div class="size-6 rounded-md bg-primary/10 border border-primary/20 flex items-center justify-center"><div class="size-1.5 rounded-full bg-primary/40"></div></div>
                <span class="text-muted-foreground">Agua</span>
            </div>
        </div>
    </div>
</div>

<!-- Formulario oculto para enviar ataque -->
<form id="attackForm" asp-action="Attack" method="post" class="hidden">
    <input type="hidden" name="gameId" value="@Model.GameId" />
    <input type="hidden" id="attackRow" name="row" value="" />
    <input type="hidden" id="attackCol" name="col" value="" />
</form>

@section Scripts {
    <script>
        function attackCell(row, col) {
            document.getElementById('attackRow').value = row;
            document.getElementById('attackCol').value = col;
            document.getElementById('attackForm').submit();
        }
        
        // Auto-refresh when it's not my turn
        @if (!Model.IsMyTurn)
        {
            <text>
            setTimeout(() => {
                window.location.reload();
            }, 5000);
            </text>
        }
    </script>
}
