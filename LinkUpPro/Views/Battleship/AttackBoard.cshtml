@model AttackBoardViewModel

@{
    ViewData["Title"] = "Tablero de Combate";

    var myAttacks = new Dictionary<string, bool>();
    if (Model.MyAttacks != null)
    {
        foreach (var attack in Model.MyAttacks)
        {
            myAttacks[$"{attack.Row},{attack.Column}"] = attack.IsHit;
        }
    }

    var oppAttacks = new Dictionary<string, bool>();
    if (Model.OpponentAttacks != null)
    {
        foreach (var attack in Model.OpponentAttacks)
        {
            oppAttacks[$"{attack.Row},{attack.Column}"] = attack.IsHit;
        }
    }

    var oppSunkCells = new HashSet<string>();
    if (Model.OpponentSunkenShips != null)
    {
        foreach (var ship in Model.OpponentSunkenShips)
        {
            foreach (var cell in ship.Cells)
            {
                oppSunkCells.Add($"{cell.Row},{cell.Column}");
            }
        }
    }

    var myShipsCells = new HashSet<string>();
    var sunkCells = new HashSet<string>();
    var mySunkenShipsList = new List<ShipType>();
    
    if (Model.MyShips != null)
    {
        foreach (var ship in Model.MyShips)
        {
            if (ship.IsSunk) mySunkenShipsList.Add(ship.ShipType);
            
            foreach (var cell in ship.Cells)
            {
                var key = $"{cell.Row},{cell.Column}";
                myShipsCells.Add(key);
                if (ship.IsSunk)
                {
                    sunkCells.Add(key);
                }
            }
        }
    }

    string[] cols = { "A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L" };

    var myLast = Model.MyAttacks?.LastOrDefault();
    var oppLast = Model.OpponentAttacks?.LastOrDefault();
    
    string GetShipName(ShipType type)
    {
        return type switch
        {
            ShipType.size2 => "Submarino",
            ShipType.size3A => "Destructor",
            ShipType.size3B => "Crucero",
            ShipType.size4 => "Acorazado",
            ShipType.size5 => "Portaaviones",
            _ => "Barco"
        };
    }
}

<div class="flex flex-col gap-6 w-full max-w-6xl mx-auto animate-in fade-in slide-in-from-bottom-4 duration-500">
    <div class="flex flex-col md:flex-row items-center justify-between rounded-xl bg-card border shadow-sm p-6 gap-4">
        <div class="flex items-center gap-4">
            <a href="/Battleship/Index" class="inline-flex items-center justify-center rounded-full bg-secondary h-10 w-10 text-muted-foreground hover:text-foreground hover:bg-secondary/80 transition-colors">
                <i data-lucide="arrow-left" class="size-5"></i>
            </a>
            <div class="flex flex-col">
                <div class="flex items-center gap-3">
                    @if (!string.IsNullOrEmpty(Model.OpponentProfilePicture))
                    {
                        <img class="size-8 rounded-full object-cover border border-border" src="@Model.OpponentProfilePicture" alt="@Model.OpponentUsername" onerror="this.src='/placeholder.svg'" />
                    }
                    else
                    {
                        <i data-lucide="crosshair" class="size-6 text-primary"></i>
                    }
                    <h1 class="text-2xl font-bold tracking-tight">
                        Batalla contra @Model.OpponentUsername
                    </h1>
                </div>
                
                <div class="flex items-center gap-2 mt-2">
                    @if (Model.IsFinished)
                    {
                        <span class="rounded-md bg-destructive/20 px-3 py-1 text-sm font-bold text-destructive border border-destructive/30 flex items-center gap-2">
                            <i data-lucide="flag" class="size-4"></i> PARTIDA FINALIZADA
                        </span>
                    }
                    else if (Model.IsMyTurn)
                    {
                        <div class="rounded-md bg-green-500/20 px-3 py-1 text-sm font-bold text-green-500 animate-pulse border border-green-500/30 flex items-center gap-2">
                            <span class="size-3 rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.8)]"></span>
                            TU TURNO
                        </div>
                    }
                    else
                    {
                        <div class="rounded-md bg-yellow-500/20 px-3 py-1 text-sm font-bold text-yellow-500 border border-yellow-500/30 flex items-center gap-2">
                            <span class="size-3 rounded-full bg-yellow-500 shadow-[0_0_8px_rgba(234,179,8,0.8)] animate-pulse"></span>
                            ESPERANDO OPONENTE
                        </div>
                    }
                </div>
            </div>
        </div>
        
        <div class="flex flex-wrap items-center gap-3">
            <button onclick="window.location.reload();" class="inline-flex h-10 items-center justify-center rounded-md bg-secondary px-4 text-sm font-medium hover:bg-secondary/80 transition-colors gap-2 border">
                <i data-lucide="refresh-cw" class="size-4"></i>
                Actualizar Estado
            </button>
            @if (!Model.IsFinished)
            {

                <form asp-action="Surrender" method="post" class="m-0">
                    <input type="hidden" name="gameId" value="@Model.GameId" />
                    <button type="submit" class="inline-flex h-10 items-center justify-center rounded-md border border-destructive bg-transparent px-4 text-sm font-medium text-destructive hover:bg-destructive hover:text-destructive-foreground transition-colors gap-2" onclick="return confirm('¿Estás seguro de que quieres rendirte?');">
                        <i data-lucide="flag-triangle-right" class="size-4"></i>
                        Rendirse
                    </button>
                </form>
            }
            else
            {
                <a href="/Battleship/Result?gameId=@Model.GameId" class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors gap-2">
                    <i data-lucide="award" class="size-4"></i>
                    Ver Resultados
                </a>
            }
        </div>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-card border rounded-lg p-3 flex flex-col justify-center items-center shadow-sm">
            <span class="text-xs text-muted-foreground uppercase font-semibold">Tu Turno</span>
            <span class="font-bold text-lg @(Model.IsMyTurn ? "text-green-500" : "text-muted-foreground")">@(Model.IsMyTurn ? "Sí" : "No")</span>
        </div>
        <div class="bg-card border rounded-lg p-3 flex flex-col justify-center items-center shadow-sm">
            <span class="text-xs text-muted-foreground uppercase font-semibold">Últ. ataque enemigo</span>
            <span class="font-bold text-lg text-foreground">
                @(oppLast != null ? $"{cols[oppLast.Column]}{oppLast.Row + 1}" : "Ninguno")
            </span>
        </div>
        <div class="bg-card border rounded-lg p-3 flex flex-col justify-center items-center shadow-sm">
            <span class="text-xs text-muted-foreground uppercase font-semibold">Tus ataques</span>
            <span class="font-bold text-lg text-foreground">@(Model.MyAttacks?.Count ?? 0)</span>
        </div>
        <div class="bg-card border rounded-lg p-3 flex flex-col justify-center items-center shadow-sm">
            <span class="text-xs text-muted-foreground uppercase font-semibold">Barcos restantes</span>
            <span class="font-bold text-lg text-primary">@(5 - mySunkenShipsList.Count)/5</span>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="rounded-xl border border-destructive/50 bg-destructive/10 px-4 py-3 text-sm text-destructive">
            @TempData["Error"]
        </div>
    }

    <div class="grid gap-8 lg:grid-cols-2">
        <div class="flex flex-col gap-4 rounded-xl border bg-card p-6 shadow-sm">
            <h2 class="text-center font-bold tracking-widest text-muted-foreground uppercase text-sm mb-2 flex items-center justify-center gap-2">
                <i data-lucide="shield-half" class="size-4"></i> Tu Tablero
            </h2>
            
            <div class="mx-auto grid gap-2" style="grid-template-columns: auto 1fr;">
                <div class="flex flex-col gap-1 pr-2">
                    <div class="grid gap-[6px] sm:gap-2" style="grid-template-columns: 1fr;">
                        <div class="flex h-6 items-center justify-center opacity-0 pointer-events-none text-[10px] sm:text-xs">0</div>
                    </div>
                    <div class="grid gap-[6px] sm:gap-2 py-[6px] sm:py-2" style="grid-template-columns: 1fr;">
                        @for (int r = 1; r <= 12; r++)
                        {
                            <div class="flex size-6 sm:size-8 items-center justify-center text-xs font-semibold text-muted-foreground">@r</div>
                        }
                    </div>
                </div>
                <div class="flex flex-col gap-1">
                    <div class="grid gap-[6px] sm:gap-2" style="grid-template-columns: repeat(12, minmax(0, 1fr));">
                        @foreach (var c in cols)
                        {
                            <div class="flex h-6 items-center justify-center text-[10px] sm:text-xs font-semibold text-muted-foreground">@c</div>
                        }
                    </div>
                    <div class="grid gap-[6px] sm:gap-2 bg-border/50 p-[6px] sm:p-2 rounded-lg" style="grid-template-columns: repeat(12, minmax(0, 1fr));">
                        @for (int r = 0; r < 12; r++)
                        {
                            for (int c = 0; c < 12; c++)
                            {
                                string key = $"{r},{c}";
                                bool isMyShip = myShipsCells.Contains(key);
                                bool isSunk = sunkCells.Contains(key);
                                bool hasBeenAttacked = oppAttacks.ContainsKey(key);
                                
                                string cellClass = "bg-secondary border border-border/80";
                                if (hasBeenAttacked)
                                {
                                    if (isMyShip)
                                    {
                                        cellClass = isSunk ? "bg-destructive border-destructive opacity-70" : "bg-destructive";
                                    }
                                    else
                                    {
                                        cellClass = "bg-primary/20 border border-primary/30";
                                    }
                                }
                                else if (isMyShip)
                                {
                                    cellClass = "bg-slate-300 dark:bg-slate-700 border border-muted-foreground/30";
                                }

                                <div class="size-6 sm:size-8 rounded-sm transition-all flex items-center justify-center text-xs @cellClass">
                                    @if (hasBeenAttacked && isMyShip)
                                    {
                                        <i data-lucide="@(isSunk ? "flame" : "cross")" class="size-4 sm:size-5 text-white drop-shadow-md"></i>
                                    }
                                    else if (hasBeenAttacked && !isMyShip)
                                    {
                                        <div class="size-1 sm:size-1.5 rounded-full bg-primary/50"></div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="flex flex-col gap-4 rounded-xl border bg-card p-6 shadow-sm relative overflow-hidden">
            <h2 class="text-center font-bold tracking-widest text-primary uppercase text-sm mb-2 flex items-center justify-center gap-2">
                <i data-lucide="swords" class="size-4"></i> Tablero Enemigo
            </h2>
            
            @if (!Model.IsMyTurn && !Model.IsFinished)
            {
                <div class="absolute inset-0 bg-background/50 backdrop-blur-[2px] z-10 flex flex-col items-center justify-center">
                    <i data-lucide="radar" class="size-10 text-primary animate-spin opacity-60 mb-3"></i>
                    <p class="font-semibold text-lg drop-shadow-md">Esperando turno</p>
                </div>
            }

            <div class="mx-auto grid gap-2" style="grid-template-columns: auto 1fr;">
                <div class="flex flex-col gap-1 pr-2">
                    <div class="grid gap-[6px] sm:gap-2" style="grid-template-columns: 1fr;">
                        <div class="flex h-6 items-center justify-center opacity-0 pointer-events-none text-[10px] sm:text-xs">0</div>
                    </div>
                    <div class="grid gap-[6px] sm:gap-2 py-[6px] sm:py-2" style="grid-template-columns: 1fr;">
                        @for (int r = 1; r <= 12; r++)
                        {
                            <div class="flex size-6 sm:size-8 items-center justify-center text-xs font-semibold text-muted-foreground">@r</div>
                        }
                    </div>
                </div>
                <div class="flex flex-col gap-1">
                    <div class="grid gap-[6px] sm:gap-2" style="grid-template-columns: repeat(12, minmax(0, 1fr));">
                        @foreach (var c in cols)
                        {
                            <div class="flex h-6 items-center justify-center text-[10px] sm:text-xs font-semibold text-muted-foreground">@c</div>
                        }
                    </div>
                    <div class="grid gap-[6px] sm:gap-2 bg-border/50 p-[6px] sm:p-2 rounded-lg" style="grid-template-columns: repeat(12, minmax(0, 1fr));">
                        @for (int r = 0; r < 12; r++)
                        {
                            for (int c = 0; c < 12; c++)
                            {
                                string key = $"{r},{c}";
                                bool hasAttacked = myAttacks.ContainsKey(key);
                                bool isHit = hasAttacked && myAttacks[key];
                                bool isEnemySunk = oppSunkCells.Contains(key);

                                if (hasAttacked)
                                {
                                    <div class="size-6 sm:size-8 rounded-sm flex items-center justify-center @(isHit ? (isEnemySunk ? "bg-destructive border-destructive opacity-70" : "bg-destructive") : "bg-primary/20 border border-primary/30")">
                                        @if (isHit)
                                        {
                                            <i data-lucide="@(isEnemySunk ? "flame" : "cross")" class="size-4 sm:size-5 text-white drop-shadow-md"></i>
                                        }
                                        else
                                        {
                                            <div class="size-1 sm:size-1.5 rounded-full bg-primary/50"></div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <button type="button" 
                                            onclick="attackCell(@r, @c)"
                                            @(Model.IsMyTurn ? "" : "disabled")
                                            class="size-6 sm:size-8 rounded-sm transition-all flex items-center justify-center bg-secondary hover:bg-primary/40 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed border border-border/80">
                                    </button>
                                }
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
        
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
        <div class="bg-card rounded-xl border p-5 shadow-sm lg:col-span-2">
            <h3 class="font-semibold text-muted-foreground mb-4">Leyenda del Mapa</h3>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                <div class="flex items-center gap-3">
                    <div class="size-8 rounded-sm bg-slate-300 dark:bg-slate-700 border border-muted-foreground/30 flex items-center justify-center"><i data-lucide="ship" class="size-4 text-slate-600 dark:text-slate-300"></i></div>
                    <span class="text-sm font-medium">Barco propio</span>
                </div>
                <div class="flex items-center gap-3">
                    <div class="size-8 rounded-sm bg-destructive flex items-center justify-center"><i data-lucide="cross" class="size-5 text-white drop-shadow-md"></i></div>
                    <span class="text-sm font-medium">Impacto</span>
                </div>
                <div class="flex items-center gap-3">
                    <div class="size-8 rounded-sm bg-primary/20 border border-primary/30 flex items-center justify-center"><div class="size-2 rounded-full bg-primary/50"></div></div>
                    <span class="text-sm font-medium">Agua</span>
                </div>
                <div class="flex items-center gap-3">
                    <div class="size-8 rounded-sm bg-destructive border-destructive flex items-center justify-center opacity-70"><i data-lucide="flame" class="size-4 text-white"></i></div>
                    <span class="text-sm font-medium">Hundido</span>
                </div>
            </div>
            
            <div class="mt-4 pt-4 border-t text-sm font-mono text-muted-foreground">
                @if(Model.MyAttacks != null && Model.MyAttacks.Any())
                {
                    var last = Model.MyAttacks.Last();
                    <span>Tu último disparo: @cols[last.Column]@(last.Row + 1) (@(last.IsHit ? "Impacto" : "Agua"))</span>
                }
            </div>
        </div>
        <div class="bg-card rounded-xl border p-5 shadow-sm">
            <h3 class="font-semibold text-muted-foreground mb-4">Registro de Daños</h3>
            
            <div class="flex flex-col gap-4">
                <div>
                    <span class="text-xs font-bold uppercase text-primary mb-2 block">Flota Enemiga Hundida</span>
                    <ul class="space-y-1">
                        @if (Model.OpponentSunkenShips != null && Model.OpponentSunkenShips.Any())
                        {
                            foreach (var ship in Model.OpponentSunkenShips)
                            {
                                <li class="text-sm flex items-center gap-2 text-destructive"><i data-lucide="check-circle-2" class="size-4"></i> @GetShipName(ship.ShipType)</li>
                            }
                        }
                        else
                        {
                            <li class="text-sm text-muted-foreground italic">Ningún barco enemigo hundido aún</li>
                        }
                    </ul>
                </div>
                
                <div class="border-t pt-3">
                    <span class="text-xs font-bold uppercase text-muted-foreground mb-2 block">Tus Barcos Perdidos</span>
                    <ul class="space-y-1">
                        @if (mySunkenShipsList.Any())
                        {
                            foreach (var type in mySunkenShipsList)
                            {
                                <li class="text-sm flex items-center gap-2 text-destructive/80"><i data-lucide="skull" class="size-4"></i> @GetShipName(type)</li>
                            }
                        }
                        else
                        {
                            <li class="text-sm text-muted-foreground italic">Todos tus barcos están a flote</li>
                        }
                    </ul>
                </div>
            </div>
        </div>

    </div>
</div>

<form id="attackForm" asp-action="Attack" method="post" class="hidden">
    <input type="hidden" name="gameId" value="@Model.GameId" />
    <input type="hidden" id="attackRow" name="row" value="" />
    <input type="hidden" id="attackCol" name="col" value="" />
</form>

@section Scripts {
    <script src="~/js/battleship-attackboard.js" asp-append-version="true"></script>
}
