@model AttackBoardViewModel
@{
    ViewData["Title"] = "Attack";
}

@section Styles {
    <link rel="stylesheet" href="~/css/battleship.css" asp-append-version="true" />
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="display-6">Attack Board</h1>
        <div>
            <span class="badge bg-@(Model.IsMyTurn ? "success" : "secondary") fs-6 p-2">
                @(Model.IsMyTurn ? "Your Turn" : $"{Model.CurrentTurnUsername}'s Turn")
            </span>
        </div>
    </div>

    <p class="text-muted">Attacking: <strong>@Model.OpponentUsername</strong></p>

    @if (TempData["Error"] is string errorMsg)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMsg
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form id="attackForm" asp-action="Attack" method="post">
        <input type="hidden" name="gameId" value="@Model.GameId" />
        <input type="hidden" name="row" id="attackRow" />
        <input type="hidden" name="col" id="attackCol" />

        <div class="row">
            <div class="col-md-auto">
                <div class="board" id="attackBoard">
                    <div class="board-header">
                        <div class="cell-label"></div>
                        @for (int c = 1; c <= 12; c++)
                        {
                            <div class="cell-label">@c</div>
                        }
                    </div>
                    @for (int r = 1; r <= 12; r++)
                    {
                        <div class="board-row">
                            <div class="cell-label">@r</div>
                            @for (int c = 1; c <= 12; c++)
                            {
                                var attack = Model.MyAttacks.FirstOrDefault(a => a.Row == r && a.Column == c);
                                var cellClass = "cell";
                                if (attack != null)
                                {
                                    cellClass += attack.IsHit ? " hit" : " miss";
                                }
                                <div class="@cellClass"
                                     data-row="@r" data-col="@c"
                                     data-attacked="@(attack != null ? "true" : "false")">
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Controls</h5>
                        <p>Click a cell to attack, then confirm.</p>
                        <p class="text-muted small">Selected: <span id="attackCellDisplay">None</span></p>
                        <button type="submit" class="btn btn-danger w-100" id="attackBtn" @(!Model.IsMyTurn ? "disabled" : "")>
                            @(Model.IsMyTurn ? "Attack!" : "Not Your Turn")
                        </button>
                        <hr />
                        <form asp-action="Surrender" method="post" onsubmit="return confirm('Are you sure you want to surrender?')">
                            <input type="hidden" name="gameId" value="@Model.GameId" />
                            <button type="submit" class="btn btn-outline-warning w-100">Surrender</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>
</div>

@section Scripts {
    <script src="~/js/battleship.js" asp-append-version="true"></script>
}
