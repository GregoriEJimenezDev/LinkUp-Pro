@model SelectShipViewModel
@{
    ViewData["Title"] = "Place Your Ships";
}

<div class="container mt-4">
    <h1 class="display-6 mb-2">Place Your Ships</h1>
    <p class="text-muted">You need to place 5 ships. Select a ship type to position it on the board.</p>

    @if (TempData["Error"] is string errorMsg)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMsg
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <h5>Ships to Place</h5>
            @if (!Model.PendingShips.Any())
            {
                <div class="alert alert-success">
                    All ships placed! Waiting for opponent...
                    <a asp-action="AttackBoard" asp-route-gameId="@Model.GameId" class="btn btn-success mt-2">Go to Battle</a>
                </div>
            }
            else
            {
                <div class="list-group mb-3">
                    @foreach (var ship in Model.PendingShips)
                    {
                        <a asp-action="PlaceShip" asp-route-gameId="@Model.GameId" asp-route-shipType="@ship.ShipType" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <span>@ship.ShipType (Size @ship.Size)</span>
                            <span class="badge bg-primary rounded-pill">@ship.Size cells</span>
                        </a>
                    }
                </div>
            }
        </div>

        <div class="col-md-6">
            <h5>Placed Ships</h5>
            @if (!Model.PlacedShips.Any())
            {
                <p class="text-muted">No ships placed yet.</p>
            }
            else
            {
                <div class="list-group">
                    @foreach (var ship in Model.PlacedShips)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@ship.ShipType (Size @ship.Size)</span>
                            <span class="badge bg-success">Placed</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>
</div>
