@model SelectShipViewModel

@{
    ViewData["Title"] = "Fase de preparación";
}

<div class="flex flex-col gap-6 w-full max-w-4xl mx-auto animate-in fade-in slide-in-from-bottom-4 duration-500">
    <div class="flex items-center gap-4 border-b pb-4">
        <a href="/Battleship/Index" class="inline-flex items-center justify-center rounded-full bg-secondary h-10 w-10 text-muted-foreground hover:text-foreground hover:bg-secondary/80 transition-colors">
            <i data-lucide="arrow-left" class="size-5"></i>
        </a>
        <div class="flex flex-col">
            <h1 class="text-2xl font-bold tracking-tight text-foreground">Coloca tus barcos</h1>
            <p class="text-sm text-muted-foreground">Prepara tu flota para el combate</p>
        </div>
        
        <button onclick="window.location.reload();" class="ml-auto inline-flex items-center justify-center rounded-md bg-secondary px-4 py-2 text-sm font-medium hover:bg-secondary/80 transition-colors gap-2 border">
            <i data-lucide="refresh-cw" class="size-4"></i>
            Actualizar Estado
        </button>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="rounded-xl border border-destructive/50 bg-destructive/10 px-4 py-3 text-sm text-destructive">
            @TempData["Error"]
        </div>
    }

    <div class="grid gap-6 md:grid-cols-[1fr_300px]">
        <div class="flex flex-col gap-6">
            @if (Model.PendingShips.Any())
            {
                <div class="flex flex-col gap-3">
                    <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">Flota Disponible (@Model.PendingShips.Count)</h2>
                    <div class="grid gap-3">
                        @foreach (var ship in Model.PendingShips)
                        {
                            <a href="/Battleship/PlaceShip?gameId=@Model.GameId&shipType=@ship.ShipType" class="group flex items-center justify-between rounded-lg border bg-card p-4 hover:bg-accent/50 transition-colors">
                                <div class="flex items-center gap-4">
                                    <div class="flex size-10 items-center justify-center rounded-md bg-primary/10">
                                        @if(ship.ShipType == ShipType.size2)
                                        {
                                            <i data-lucide="sailboat" class="size-5 text-primary"></i>
                                        }
                                        else if(ship.ShipType == ShipType.size3A)
                                        {
                                            <i data-lucide="waves" class="size-5 text-primary"></i>
                                        }
                                        else if(ship.ShipType == ShipType.size5)
                                        {
                                            <i data-lucide="ship" class="size-5 text-primary"></i>
                                        }
                                        else
                                        {
                                            <i data-lucide="anchor" class="size-5 text-primary"></i>
                                        }
                                    </div>
                                    <div class="flex flex-col gap-1">
                                        <span class="font-semibold text-sm">
                                            @switch (ship.ShipType)
                                            {
                                                case ShipType.size2: <text>Patrulla</text> break;
                                                case ShipType.size3A: <text>Submarino</text> break;
                                                case ShipType.size3B: <text>Destructor</text> break;
                                                case ShipType.size4: <text>Acorazado</text> break;
                                                case ShipType.size5: <text>Portaaviones</text> break;
                                            }
                                        </span>
                                        <div class="flex items-center gap-1">
                                            @for (int i = 0; i < ship.Size; i++)
                                            {
                                                <div class="h-2 w-3 rounded-sm bg-primary/40 group-hover:bg-primary transition-colors"></div>
                                            }
                                            <span class="text-[10px] text-muted-foreground ml-2">(@ship.Size espacios)</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex h-8 w-8 items-center justify-center rounded-full bg-secondary text-muted-foreground group-hover:bg-primary group-hover:text-primary-foreground transition-colors">
                                    <i data-lucide="arrow-right" class="size-4"></i>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="flex flex-col items-center justify-center h-full min-h-[300px] rounded-lg border border-dashed bg-card/50 p-8 text-center text-sm text-muted-foreground">
                    <div class="flex size-16 items-center justify-center rounded-full bg-success/20 mb-4">
                        <i data-lucide="check" class="size-8 text-success"></i>
                    </div>
                    <p class="font-bold text-lg text-foreground mb-1">¡Flota posicionada!</p>
                    <p class="mb-6 max-w-sm">Has colocado todas tus naves en el tablero y estás listo para la batalla.</p>
                    <a href="/Battleship/AttackBoard?gameId=@Model.GameId" class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-8 font-medium text-primary-foreground hover:bg-primary/90 transition-colors gap-2">
                        <i data-lucide="swords" class="size-4"></i> Ir al combate
                    </a>
                </div>
            }
        </div>
        <div class="flex flex-col gap-4">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">Estado del Tablero</h2>
            <div class="flex flex-col gap-2 rounded-lg border bg-card p-4">
                <div class="flex items-center justify-between text-sm">
                    <span class="text-muted-foreground">Posicionadas</span>
                    <span class="font-medium text-success">@Model.PlacedShips.Count</span>
                </div>
                <div class="flex items-center justify-between text-sm">
                    <span class="text-muted-foreground">Pendientes</span>
                    <span class="font-medium">@Model.PendingShips.Count</span>
                </div>
                
                <div class="my-2 h-[1px] w-full bg-border"></div>
                
                @if (Model.PlacedShips.Any())
                {
                    <div class="flex flex-col gap-2">
                        @foreach (var ship in Model.PlacedShips)
                        {
                            <div class="flex items-center gap-2 text-sm text-muted-foreground">
                                <i data-lucide="check-circle-2" class="size-4 text-success"></i>
                                <span>
                                    @switch (ship.ShipType)
                                    {
                                        case ShipType.size2: <text>Patrulla</text> break;
                                        case ShipType.size3A: <text>Submarino</text> break;
                                        case ShipType.size3B: <text>Destructor</text> break;
                                        case ShipType.size4: <text>Acorazado</text> break;
                                        case ShipType.size5: <text>Portaaviones</text> break;
                                    }
                                </span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-xs text-muted-foreground italic text-center py-2">Ninguna nave posicionada.</p>
                }
            </div>
        </div>
    </div>
</div>
