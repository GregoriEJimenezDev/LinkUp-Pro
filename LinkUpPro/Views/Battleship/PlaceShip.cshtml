@model SelectCellViewModel

@{
    ViewData["Title"] = "Colocar nave";
    var occupied = new HashSet<string>();
    if (Model.OccupiedCells != null)
    {
        foreach (var cell in Model.OccupiedCells)
        {
            occupied.Add($"{cell.Row},{cell.Col}");
        }
    }
}

<div class="flex flex-col gap-6 w-full max-w-4xl mx-auto animate-in fade-in slide-in-from-bottom-4 duration-500">
    <div class="flex items-center gap-4 border-b pb-4">
        <a href="/Battleship/SelectShip?gameId=@Model.GameId" class="inline-flex items-center justify-center rounded-full bg-secondary h-10 w-10 text-muted-foreground hover:text-foreground hover:bg-secondary/80 transition-colors">
            <i data-lucide="arrow-left" class="size-5"></i>
        </a>
        <div class="flex flex-col">
            <h1 class="text-2xl font-bold tracking-tight text-foreground">Coloca tus barcos</h1>
            <p class="text-sm text-muted-foreground">Posicionando: <span class="font-semibold text-primary">@Model.ShipType</span> (@Model.ShipSize espacios)</p>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="rounded-xl border border-destructive/50 bg-destructive/10 px-4 py-3 text-sm text-destructive">
            @TempData["Error"]
        </div>
    }

    <div class="grid gap-8 md:grid-cols-[1fr_300px]">
        <div class="flex flex-col gap-4 rounded-xl border bg-card p-6 shadow-sm relative overflow-hidden">
            <h2 class="text-center font-bold tracking-widest text-muted-foreground uppercase text-xs mb-2">Tu Tablero</h2>
            
            <div class="mx-auto grid gap-2" style="grid-template-columns: auto 1fr;">
                <div class="flex flex-col gap-1 pr-2 pt-6">
                    @for (int r = 1; r <= 12; r++)
                    {
                        <div class="flex size-7 sm:size-8 md:size-10 items-center justify-center text-xs font-semibold text-muted-foreground">@r</div>
                    }
                </div>
                
                <div class="flex flex-col gap-1">
                    <div class="grid gap-1" style="grid-template-columns: repeat(12, minmax(0, 1fr));">
                        @{ string[] cols = { "A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L" }; }
                        @foreach (var c in cols)
                        {
                            <div class="flex h-6 items-center justify-center text-xs font-semibold text-muted-foreground">@c</div>
                        }
                    </div>

                    <div class="grid gap-1 bg-border/50 p-1 rounded-lg" id="battleship-board" style="grid-template-columns: repeat(12, minmax(0, 1fr));">
                        @for (int r = 0; r < 12; r++)
                        {
                            for (int c = 0; c < 12; c++)
                            {
                                bool isOccupied = occupied.Contains($"{r},{c}");
                                <button type="button" 
                                        class="board-cell size-7 sm:size-8 md:size-10 rounded-sm transition-all flex items-center justify-center text-xs @(isOccupied ? "bg-primary/40 cursor-not-allowed" : "bg-secondary hover:bg-primary/20 cursor-pointer") border border-border/80"
                                        data-row="@r" 
                                        data-col="@c"
                                        @(isOccupied ? "disabled" : "")
                                        onclick="selectCell(@r, @c, this)">
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>
            
            <p class="text-xs text-muted-foreground mt-4 text-center">Selecciona la coordenada inicial en el tablero</p>
        </div>

        <div class="flex flex-col rounded-xl border bg-card p-6 shadow-sm">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mb-4">Controles</h2>
            
            <form asp-action="PlaceShip" method="post" class="flex flex-col gap-6 flex-1">
                <input type="hidden" name="gameId" value="@Model.GameId" />
                <input type="hidden" name="shipType" value="@Model.ShipType" />
                <input type="hidden" id="inputRow" name="row" value="" required />
                <input type="hidden" id="inputCol" name="col" value="" required />

                <div class="flex flex-col gap-2">
                    <span class="text-sm font-medium">Coordenada seleccionada</span>
                    <div id="selected-coords" class="flex items-center justify-center rounded-lg border border-dashed bg-secondary/50 p-4 text-2xl font-mono text-muted-foreground transition-colors">
                        --
                    </div>
                </div>

                <div class="flex flex-col gap-2 mt-2">
                    <span class="text-sm font-medium">Orientación</span>
                    <div class="relative">
                        <select id="inputDir" name="direction" onchange="updateDirectionHint()" class="block h-11 w-full rounded-lg border bg-secondary/50 px-4 text-sm font-medium transition-colors hover:bg-secondary focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" required>
                            <option value="3">Derecha</option>
                            <option value="1">Abajo</option>
                            <option value="2">Izquierda</option>
                            <option value="0">Arriba</option>
                        </select>
                    </div>
                    <p class="text-xs text-muted-foreground mt-1">La nave se extenderá hacia la <span id="directionHint" class="font-semibold text-foreground">derecha</span>.</p>
                </div>

                <div class="mt-auto pt-4 flex flex-col gap-3">
                    <button type="submit" id="submitBtn" disabled class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-11 px-8 rounded-md shadow-sm w-full gap-2">
                        <i data-lucide="check" class="size-4"></i>
                        Confirmar posición
                    </button>
                    
                    <a href="/Battleship/SelectShip?gameId=@Model.GameId" class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-11 px-8 rounded-md w-full">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const columns = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J', 'K', 'L'];
        
        function updateDirectionHint() {
            const select = document.getElementById('inputDir');
            const hint = select.options[select.selectedIndex].text.toLowerCase();
            document.getElementById('directionHint').textContent = hint;

            const r = document.getElementById('inputRow').value;
            const c = document.getElementById('inputCol').value;
            if (r !== "" && c !== "") {
                const btn = document.querySelector(`.board-cell[data-row="${r}"][data-col="${c}"]`);
                if (btn) selectCell(parseInt(r), parseInt(c), btn);
            }
        }
        
        function selectCell(row, col, btnElement) {
            document.querySelectorAll('.board-cell').forEach(el => {
                el.classList.remove('ring-2', 'ring-primary', 'ring-offset-2', 'bg-primary/20', 'border-primary');
            });

            btnElement.classList.add('ring-2', 'ring-primary', 'ring-offset-2', 'bg-primary/20');
            document.getElementById('inputRow').value = row;
            document.getElementById('inputCol').value = col;

            document.getElementById('selected-coords').textContent = columns[col] + (row + 1);
            document.getElementById('selected-coords').classList.add('text-primary', 'border-primary', 'bg-primary/10');
            document.getElementById('selected-coords').classList.remove('text-muted-foreground', 'border-dashed', 'bg-secondary/50');
            
            document.getElementById('submitBtn').disabled = false;
        }
    </script>
}
