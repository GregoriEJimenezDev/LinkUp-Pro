@model LinkUpPro.Core.Application.ViewModel.Friend.FriendIndexViewModel

@{
    ViewData["Title"] = "Mis Amigos";
}

<div class="flex flex-col md:flex-row gap-6 w-full max-w-6xl mx-auto animate-in fade-in slide-in-from-bottom-4 duration-500">
    
    <!-- Lista de Amigos -->
    <div class="w-full md:w-1/3 flex flex-col gap-6">
        <div class="flex items-center justify-between">
            <h1 class="text-2xl font-bold tracking-tight text-foreground">Mis Amigos</h1>
            <span class="rounded-full bg-secondary px-2.5 py-0.5 text-xs font-medium">@Model.Friends.Count</span>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="rounded-xl border border-destructive/50 bg-destructive/10 px-4 py-3 text-sm text-destructive">
                @TempData["Error"]
            </div>
        }

        <div class="flex flex-col gap-3">
            @if (Model.Friends != null && Model.Friends.Any())
            {
                foreach (var friend in Model.Friends)
                {
                    <div class="flex items-center justify-between rounded-xl border bg-card p-4 shadow-sm transition-all hover:border-primary/50">
                        <div class="flex items-center gap-3">
                            <div class="relative flex size-12 shrink-0 overflow-hidden rounded-full border border-border">
                                <img class="aspect-square h-full w-full object-cover" src="@friend.ProfilePicture" alt="@friend.Username" onerror="this.src='/placeholder.svg'" />
                            </div>
                            <div class="flex flex-col">
                                <span class="text-sm font-semibold">@friend.FullName</span>
                                <span class="text-xs text-muted-foreground">@@@friend.Username</span>
                            </div>
                        </div>
                        
                        <form asp-action="Remove" asp-controller="Friendship" method="post" onsubmit="return confirm('¿Seguro que deseas eliminar a este amigo?');">
                            <input type="hidden" name="id" value="@friend.FriendshipId" />
                            <button type="submit" class="inline-flex size-8 items-center justify-center rounded-full text-muted-foreground hover:bg-destructive/10 hover:text-destructive transition-colors" title="Eliminar amigo">
                                <i data-lucide="user-minus" class="size-4"></i>
                            </button>
                        </form>
                    </div>
                }
            }
            else
            {
                <div class="flex flex-col items-center justify-center rounded-2xl border border-dashed p-8 text-center text-sm text-muted-foreground bg-card/50">
                    <i data-lucide="users" class="mb-3 size-8 opacity-20"></i>
                    <p class="font-medium text-foreground">Aún no tienes amigos</p>
                    <p class="mt-1">Agrega amigos para ver sus publicaciones aquí.</p>
                    <a href="/FriendRequest/Add" class="mt-4 rounded-full bg-primary px-4 py-2 text-xs font-medium text-primary-foreground hover:bg-primary/90">
                        Buscar amigos
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Muro de Publicaciones de Amigos -->
    <div class="w-full md:w-2/3 flex flex-col gap-6">
        <h2 class="text-xl font-semibold tracking-tight text-foreground flex items-center gap-2">
            <i data-lucide="activity" class="size-5 text-primary"></i>
            Actividad Reciente
        </h2>

        <div class="flex flex-col gap-6">
            @if (Model.FriendsPosts != null && Model.FriendsPosts.Any())
            {
                foreach (var post in Model.FriendsPosts)
                {
                    <div class="rounded-2xl border bg-card text-card-foreground shadow-sm">
                        <!-- Post Header -->
                        <div class="flex flex-row items-center justify-between p-6">
                            <div class="flex items-center gap-3">
                                <span class="relative flex h-10 w-10 shrink-0 overflow-hidden rounded-full border border-border">
                                    <img class="aspect-square h-full w-full object-cover bg-secondary" src="@post.UserProfilePicture" alt="@post.Username" onerror="this.src='/placeholder.svg'" />
                                </span>
                                <div class="flex flex-col">
                                    <span class="text-sm font-semibold leading-none">@post.Username</span>
                                    <span class="text-xs text-muted-foreground mt-1">@post.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                                </div>
                            </div>
                        </div>

                        <!-- Post Content -->
                        <div class="p-6 pt-0 flex flex-col gap-4">
                            <p class="text-sm">@post.Content</p>
                            @if (!string.IsNullOrEmpty(post.MediaUrl))
                            {
                                <div class="relative overflow-hidden rounded-xl border border-border">
                                    <img src="@post.MediaUrl" alt="Post image" class="object-cover w-full max-h-[500px]" />
                                </div>
                            }
                        </div>
                        
                        <!-- Post Actions (Solo lectura en muro de amigos) -->
                        <div class="flex items-center p-6 pt-0">
                            <div class="flex items-center gap-4 w-full border-t pt-4">
                                <button class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors hover:bg-secondary/80 h-9 px-4 py-2 text-muted-foreground">
                                    <i data-lucide="heart" class="size-4 mr-2"></i>
                                    Like
                                </button>
                                <button class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors hover:bg-secondary/80 h-9 px-4 py-2 text-muted-foreground">
                                    <i data-lucide="message-square" class="size-4 mr-2"></i>
                                    Comentar
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="flex flex-col items-center justify-center rounded-2xl border border-dashed bg-card/50 p-12 text-center text-muted-foreground">
                    <i data-lucide="newspaper" class="mb-4 size-10 opacity-20"></i>
                    <p class="font-medium text-foreground">No hay publicaciones recientes</p>
                    <p class="text-sm mt-1">Tus amigos aún no han publicado nada nuevo.</p>
                </div>
            }
        </div>
    </div>
</div>
