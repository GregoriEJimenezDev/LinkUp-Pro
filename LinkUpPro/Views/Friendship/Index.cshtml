@model FriendIndexViewModel

@{
    ViewData["Title"] = "Mis Amigos";
}

<div class="flex flex-col md:flex-row gap-6 w-full max-w-6xl mx-auto animate-in fade-in slide-in-from-bottom-4 duration-500">
    
    <div class="w-full max-w-3xl mx-auto flex flex-col gap-6">
        <div class="flex items-center justify-between">
            <h1 class="text-2xl font-bold tracking-tight text-foreground">Mis Amigos</h1>
            <span class="rounded-full bg-secondary px-2.5 py-0.5 text-xs font-medium">@Model.Friends.Count</span>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="rounded-xl border border-destructive/50 bg-destructive/10 px-4 py-3 text-sm text-destructive">
                @TempData["Error"]
            </div>
        }

        <div class="flex flex-col gap-3">
            @if (Model.Friends != null && Model.Friends.Any())
            {
                foreach (var friend in Model.Friends)
                {
                    <div class="flex items-center justify-between rounded-xl border bg-card p-4 shadow-sm transition-all hover:border-primary/50">
                        <div class="flex items-center gap-3">
                            <div class="relative flex size-12 shrink-0 overflow-hidden rounded-full border border-border">
                                <img class="aspect-square h-full w-full object-cover" src="@friend.ProfilePicture" alt="@friend.Username" onerror="this.src='/placeholder.svg'" />
                            </div>
                            <div class="flex flex-col">
                                <span class="text-sm font-semibold">@friend.FullName</span>
                                <span class="text-xs text-muted-foreground">@@@friend.Username</span>
                            </div>
                        </div>
                        
                        <form asp-action="Remove" asp-controller="Friendship" method="post" onsubmit="return confirm('¿Seguro que deseas eliminar a este amigo?');">
                            <input type="hidden" name="id" value="@friend.FriendshipId" />
                            <button type="submit" class="inline-flex size-8 items-center justify-center rounded-full text-muted-foreground hover:bg-destructive/10 hover:text-destructive transition-colors" title="Eliminar amigo">
                                <i data-lucide="user-minus" class="size-4"></i>
                            </button>
                        </form>
                    </div>
                }
            }
            else
            {
                <div class="flex flex-col items-center justify-center rounded-2xl border border-dashed p-8 text-center text-sm text-muted-foreground bg-card/50">
                    <i data-lucide="users" class="mb-3 size-8 opacity-20"></i>
                    <p class="font-medium text-foreground">Todavía no tiene amigos agregados.</p>
                    <a href="/FriendRequest/Add" class="mt-4 rounded-full bg-primary px-4 py-2 text-xs font-medium text-primary-foreground hover:bg-primary/90">
                        Buscar amigos
                    </a>
                </div>
            }
        </div>
    </div>

    <div class="w-full max-w-3xl mx-auto flex flex-col gap-6">
        <div class="flex items-center justify-between">
            <h2 class="text-2xl font-bold tracking-tight text-foreground">Publicaciones de Amigos</h2>
        </div>

        <form asp-controller="Friendship" asp-action="Index" method="get" class="flex flex-col gap-3 p-4 bg-card rounded-2xl border shadow-sm">
            <div class="relative">
                <i data-lucide="search" class="absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted-foreground"></i>
                <input type="text" name="search" value="@ViewBag.SearchTerm" placeholder="Buscar publicaciones de amigos..." class="flex h-10 w-full border border-input px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 rounded-full bg-background pl-9" />
            </div>
            <div class="flex flex-wrap gap-3 items-center">
                <div class="flex items-center gap-2">
                    <label class="text-sm text-muted-foreground">Amigo:</label>
                    <select name="friendUsername" class="h-8 rounded-md border border-input bg-transparent px-3 py-1 text-xs shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring">
                        <option value="">Todos</option>
                        @if (Model.Friends != null)
                        {
                            foreach (var friend in Model.Friends)
                            {
                                @if (Model.FriendUsername == friend.Username)
                                {
                                    <option value="@friend.Username" selected>@friend.Username</option>
                                }
                                else
                                {
                                    <option value="@friend.Username">@friend.Username</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div class="flex items-center gap-2">
                    <label class="text-sm text-muted-foreground">Desde:</label>
                    <input type="date" name="dateFrom" value="@Model.FilterDateFrom?.ToString("yyyy-MM-dd")" class="h-8 rounded-md border border-input bg-transparent px-3 py-1 text-xs shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" />
                </div>
                <div class="flex items-center gap-2">
                    <label class="text-sm text-muted-foreground">Hasta:</label>
                    <input type="date" name="dateTo" value="@Model.FilterDateTo?.ToString("yyyy-MM-dd")" class="h-8 rounded-md border border-input bg-transparent px-3 py-1 text-xs shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" />
                </div>
                <div class="flex items-center gap-2">
                    <label class="text-sm text-muted-foreground">Tipo:</label>
                    <select name="mediaType" class="h-8 rounded-md border border-input bg-transparent px-3 py-1 text-xs shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring">
                        <option value="">Todos</option>
                        @if (Model.FilterMediaType == LinkUpPro.Core.Domain.Enum.MediaType.Image)
                        {
                            <option value="0" selected>Imagen</option>
                        }
                        else
                        {
                            <option value="0">Imagen</option>
                        }
                        
                        @if (Model.FilterMediaType == LinkUpPro.Core.Domain.Enum.MediaType.Video)
                        {
                            <option value="1" selected>Video</option>
                        }
                        else
                        {
                            <option value="1">Video</option>
                        }
                    </select>
                </div>
                <div class="flex items-center gap-2">
                    <label class="text-sm text-muted-foreground">Edición:</label>
                    <select name="editState" class="h-8 rounded-md border border-input bg-transparent px-3 py-1 text-xs shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring">
                        @if (!Model.FilterEditState.HasValue || Model.FilterEditState.Value == 0)
                        {
                            <option value="0" selected>Todas</option>
                        }
                        else
                        {
                            <option value="0">Todas</option>
                        }

                        @if (Model.FilterEditState == 1)
                        {
                            <option value="1" selected>Editadas</option>
                        }
                        else
                        {
                            <option value="1">Editadas</option>
                        }

                        @if (Model.FilterEditState == 2)
                        {
                            <option value="2" selected>No editadas</option>
                        }
                        else
                        {
                            <option value="2">No editadas</option>
                        }
                    </select>
                </div>
                <div class="flex-1"></div>
                <button type="submit" class="bg-primary text-primary-foreground hover:bg-primary/90 h-8 rounded-md px-4 text-xs font-medium transition-colors">
                    Filtrar
                </button>
                <a href="@Url.Action("Index", "Friendship")" class="h-8 rounded-md px-4 text-xs font-medium transition-colors border flex items-center justify-center hover:bg-muted">
                    Limpiar
                </a>
            </div>
        </form>

        <div class="flex flex-col gap-4">
            @if (Model.FriendsPosts != null && Model.FriendsPosts.Any())
            {
                foreach (var post in Model.FriendsPosts)
                {
                    <div class="rounded-2xl border bg-card text-card-foreground shadow-sm">
                        <div class="p-6 pb-4">
                            <div class="flex items-center gap-3">
                                <div class="relative flex size-10 shrink-0 overflow-hidden rounded-full">
                                    <img class="aspect-square h-full w-full object-cover" src="@post.UserProfilePicture" alt="@post.Username" onerror="this.src='/placeholder.svg'" />
                                </div>
                                <div class="flex flex-col">
                                    <p class="text-sm font-semibold leading-none">@post.Username</p>
                                    <div class="mt-1 flex items-center gap-1.5 text-xs text-muted-foreground">
                                        <span><time class="local-time" datetime="@post.CreatedAt.ToString("O")">@post.CreatedAt.ToString("g")</time></span>
                                        @if (post.UpdatedAt.HasValue)
                                        {
                                            <span class="text-[10px] ml-1">(Editado)</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="px-6 pb-4">
                            <p class="text-sm text-foreground whitespace-pre-wrap">@post.Content</p>
                        </div>

                        @if (post.MediaType == MediaType.Image && !string.IsNullOrEmpty(post.MediaUrl))
                        {
                            <div class="px-6 pb-4">
                                <div class="relative overflow-hidden rounded-xl border bg-muted/30">
                                    <img src="@post.MediaUrl" alt="Post image" class="w-full object-cover" loading="lazy" />
                                </div>
                            </div>
                        }
                        else if (post.MediaType == MediaType.Video && !string.IsNullOrEmpty(post.MediaUrl))
                        {
                            <div class="px-6 pb-4">
                                <div class="relative overflow-hidden rounded-xl border bg-muted/30 aspect-video">
                                    <iframe src="@post.MediaUrl" class="w-full h-full" frameborder="0" allowfullscreen></iframe>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="flex items-center px-6 py-2 text-sm text-muted-foreground">
                        <div class="flex items-center gap-1.5">
                            <div class="flex items-center justify-center rounded-full bg-primary p-1">
                                <i data-lucide="thumbs-up" class="size-3 text-primary-foreground fill-current"></i>
                            </div>
                            <span class="font-medium mr-2" id="likes-count-@post.Id">@post.LikesCount</span>
                            
                            <div class="flex items-center justify-center rounded-full bg-destructive p-1">
                                <i data-lucide="thumbs-down" class="size-3 text-destructive-foreground fill-current"></i>
                            </div>
                            <span class="font-medium" id="dislikes-count-@post.Id">@post.DislikesCount</span>
                        </div>
                        <div class="ml-auto flex items-center gap-3">
                            <button type="button" onclick="document.getElementById('comments-@post.Id').classList.toggle('hidden')" class="hover:underline cursor-pointer">
                                <span id="comment-count-text-@post.Id">@post.CommentsCount comentarios</span>
                            </button>
                        </div>
                    </div>

                    <div class="my-0 h-[1px] bg-border mx-6"></div>

                    <div class="flex items-center justify-between gap-1 p-2">
                        <form asp-controller="Reaction" asp-action="Toggle" method="post" class="flex-1 flex" onsubmit="handleReaction(event, this); return false;">
                            <input type="hidden" name="postId" value="@post.Id" />
                            <input type="hidden" name="isLike" value="true" />
                            <button type="submit" class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 hover:bg-accent hover:text-accent-foreground h-10 py-2 flex-1 gap-2 text-muted-foreground transform active:scale-90 @(post.CurrentUserReaction == true ? "text-primary" : "")">
                                <i data-lucide="thumbs-up" class="size-4 @(post.CurrentUserReaction == true ? "fill-current" : "")"></i>
                                Me gusta
                            </button>
                        </form>
                        
                        <form asp-controller="Reaction" asp-action="Toggle" method="post" class="flex-1 flex" onsubmit="handleReaction(event, this); return false;">
                            <input type="hidden" name="postId" value="@post.Id" />
                            <input type="hidden" name="isLike" value="false" />
                            <button type="submit" class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 hover:bg-accent hover:text-accent-foreground h-10 py-2 flex-1 gap-2 text-muted-foreground transform active:scale-90 @(post.CurrentUserReaction == false ? "text-destructive" : "")">
                                <i data-lucide="thumbs-down" class="size-4 @(post.CurrentUserReaction == false ? "fill-current" : "")"></i>
                                No me gusta
                            </button>
                        </form>

                        <button type="button" onclick="document.getElementById('comments-@post.Id').classList.toggle('hidden')" class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 hover:bg-accent hover:text-accent-foreground h-10 py-2 flex-1 gap-2 text-muted-foreground">
                            <i data-lucide="message-circle" class="size-4"></i>
                            Comentar
                        </button>
                    </div>

                    <div id="comments-@post.Id" class="hidden border-t border-border p-4 bg-muted/5">
                        @if (post.AllowComments)
                        {
                            <form asp-controller="Comment" asp-action="Create" method="post" class="flex items-start gap-3 mb-4" onsubmit="handleCommentSubmit(event, this)">
                                <input type="hidden" name="PostId" value="@post.Id" />
                                <div class="relative flex size-8 shrink-0 overflow-hidden rounded-full">
                                    <img class="aspect-square h-full w-full object-cover" src="@ViewBag.CurrentUserProfilePicture ?? "/placeholder.svg"" alt="User" onerror="this.src='/placeholder.svg'" />
                                </div>
                                <div class="flex-1 flex flex-col gap-2">
                                    <input type="text" name="Content" placeholder="Escribe un comentario..." class="flex h-9 w-full rounded-md border border-input bg-background px-3 py-1 text-sm shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" required />
                                    <button type="submit" class="self-end bg-primary text-primary-foreground hover:bg-primary/90 h-8 rounded-md px-3 text-xs font-medium">
                                        Publicar
                                    </button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <p class="text-sm text-muted-foreground text-center mb-4">Los comentarios están desactivados para esta publicación.</p>
                        }

                        @if (post.Comments != null && post.Comments.Any())
                        {
                            <div class="flex flex-col gap-4 mt-2">
                                @foreach (var comment in post.Comments)
                                {
                                    <div class="flex flex-col gap-2">
                                        <div class="flex gap-3">
                                            <a href="@Url.Action("Index", "Profile", new { id = comment.Username })" class="relative flex size-8 shrink-0 overflow-hidden rounded-full">
                                                <img class="aspect-square h-full w-full object-cover" src="@comment.UserProfilePicture" alt="@comment.Username" onerror="this.src='/placeholder.svg'" />
                                            </a>
                                            <div class="flex-1 bg-muted/30 border rounded-lg p-3 group">
                                                <div class="flex items-center justify-between">
                                                    <a href="@Url.Action("Index", "Profile", new { id = comment.Username })" class="text-sm font-semibold hover:underline">@comment.Username</a>
                                                    <div class="flex items-center gap-1">
                                                        @if (comment.Username == User.Identity!.Name && !comment.IsDeleted)
                                                        {
                                                            <button type="button" onclick="document.getElementById('edit-form-@comment.Id').classList.toggle('hidden'); document.getElementById('comment-text-@comment.Id').classList.toggle('hidden');" class="px-2 py-1 text-xs px-2 py-1.5 font-medium text-muted-foreground hover:bg-muted rounded-md transition-colors hover:text-primary">Editar</button>
                                                            <form asp-controller="Comment" asp-action="Delete" method="post" class="inline" onsubmit="handleCommentSubmit(event, this)">
                                                                <input type="hidden" name="id" value="@comment.Id" />
                                                                <input type="hidden" name="postId" value="@post.Id" />
                                                                <button type="submit" class="px-2 py-1 text-xs px-2 py-1.5 font-medium text-destructive hover:bg-muted rounded-md transition-colors">Eliminar</button>
                                                            </form>
                                                        }
                                                    </div>
                                                </div>
                                                @if (comment.IsDeleted)
                                                {
                                                    <p class="text-sm mt-1 italic text-muted-foreground">Este comentario fue eliminado.</p>
                                                }
                                                else
                                                {
                                                    <p id="comment-text-@comment.Id" class="text-sm mt-1 whitespace-pre-wrap break-words overflow-hidden">@comment.Content</p>
                                                    
                                                    <form id="edit-form-@comment.Id" asp-controller="Comment" asp-action="Edit" method="post" class="hidden flex items-start gap-3 mt-1" onsubmit="handleCommentSubmit(event, this)">
                                                    <input type="hidden" name="Id" value="@comment.Id" />
                                                    <input type="hidden" name="PostId" value="@post.Id" />
                                                    <input type="hidden" name="ParentCommentId" value="@comment.ParentCommentId" />
                                                    <div class="flex-1 flex flex-col gap-2">
                                                        <input type="text" name="Content" value="@comment.Content" class="flex h-8 w-full rounded-md border border-input bg-background px-3 py-1 text-xs shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" required />
                                                        <div class="flex justify-end gap-2">
                                                            <button type="button" onclick="document.getElementById('edit-form-@comment.Id').classList.add('hidden'); document.getElementById('comment-text-@comment.Id').classList.remove('hidden');" class="h-8 rounded-md px-3 text-xs font-medium text-muted-foreground hover:bg-accent">Cancelar</button>
                                                            <button type="submit" class="shrink-0 bg-primary text-primary-foreground hover:bg-primary/90 h-8 rounded-md px-3 text-xs font-medium">Guardar</button>
                                                        </div>
                                                    </div>
                                                </form>
                                                }
                                                <div class="flex items-center gap-3 mt-2">
                                                    <p class="text-xs text-muted-foreground"><time class="local-time" datetime="@comment.CreatedAt.ToString("O")">@comment.CreatedAt.ToString("g")</time></p>
                                                    @if (!comment.IsDeleted && post.AllowComments)
                                                    {
                                                        <button type="button" onclick="document.getElementById('reply-form-@comment.Id').classList.toggle('hidden')" class="px-2 py-1 text-xs text-muted-foreground hover:bg-muted rounded-md transition-colors hover:text-primary font-medium">Responder</button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <form id="reply-form-@comment.Id" asp-controller="Comment" asp-action="Create" method="post" class="hidden flex items-start gap-3 ml-11 mt-1" onsubmit="handleCommentSubmit(event, this)">
                                            <input type="hidden" name="PostId" value="@post.Id" />
                                            <input type="hidden" name="ParentCommentId" value="@comment.Id" />
                                            <div class="flex-1 flex flex-col gap-2">
                                                <input type="text" name="Content" placeholder="Escribe una respuesta..." class="flex h-8 w-full rounded-md border border-input bg-background px-3 py-1 text-xs shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" required />
                                                <button type="submit" class="shrink-0 self-end bg-primary text-primary-foreground hover:bg-primary/90 h-8 rounded-md px-3 text-xs font-medium">
                                                    Responder
                                                </button>
                                            </div>
                                        </form>

                                        @if (comment.Replies != null && comment.Replies.Any())
                                        {
                                            <div class="flex flex-col gap-3 ml-11 mt-1">
                                                @foreach (var reply in comment.Replies)
                                                {
                                                    <div class="flex gap-3">
                                                        <a href="@Url.Action("Index", "Profile", new { id = reply.Username })" class="relative flex size-6 shrink-0 overflow-hidden rounded-full mt-1">
                                                            <img class="aspect-square h-full w-full object-cover" src="@reply.UserProfilePicture" alt="@reply.Username" onerror="this.src='/placeholder.svg'" />
                                                        </a>
                                                        <div class="flex-1 bg-muted/20 border rounded-lg p-2 group">
                                                            <div class="flex items-center justify-between">
                                                                <a href="@Url.Action("Index", "Profile", new { id = reply.Username })" class="text-xs font-semibold hover:underline">@reply.Username</a>
                                                                @if (reply.Username == User.Identity!.Name && !reply.IsDeleted)
                                                                {
                                                                    <div class="flex items-center gap-1">
                                                                        <button type="button" onclick="document.getElementById('edit-form-@reply.Id').classList.toggle('hidden'); document.getElementById('reply-text-@reply.Id').classList.toggle('hidden');" class="px-2 py-1 text-xs px-2 py-1.5 font-medium text-muted-foreground hover:bg-muted rounded-md transition-colors hover:text-primary">Editar</button>
                                                                        <form asp-controller="Comment" asp-action="Delete" method="post" class="inline" onsubmit="handleCommentSubmit(event, this)">
                                                                            <input type="hidden" name="id" value="@reply.Id" />
                                                                            <input type="hidden" name="postId" value="@post.Id" />
                                                                            <button type="submit" class="px-2 py-1 text-xs px-2 py-1.5 font-medium text-destructive hover:bg-muted rounded-md transition-colors">Eliminar</button>
                                                                        </form>
                                                                    </div>
                                                                }
                                                            </div>
                                                            @if (reply.IsDeleted)
                                                            {
                                                                <p class="text-xs mt-1 italic text-muted-foreground">Este comentario fue eliminado.</p>
                                                            }
                                                            else
                                                            {
                                                                <p id="reply-text-@reply.Id" class="text-xs mt-1 whitespace-pre-wrap break-words overflow-hidden">@reply.Content</p>
                                                                
                                                                <form id="edit-form-@reply.Id" asp-controller="Comment" asp-action="Edit" method="post" class="hidden flex items-start gap-3 mt-1" onsubmit="handleCommentSubmit(event, this)">
                                                                    <input type="hidden" name="Id" value="@reply.Id" />
                                                                    <input type="hidden" name="PostId" value="@post.Id" />
                                                                    <input type="hidden" name="ParentCommentId" value="@reply.ParentCommentId" />
                                                                    <div class="flex-1 flex flex-col gap-2">
                                                                        <input type="text" name="Content" value="@reply.Content" class="flex h-8 w-full rounded-md border border-input bg-background px-3 py-1 text-xs shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" required />
                                                                        <div class="flex justify-end gap-2">
                                                                            <button type="button" onclick="document.getElementById('edit-form-@reply.Id').classList.add('hidden'); document.getElementById('reply-text-@reply.Id').classList.remove('hidden');" class="h-8 rounded-md px-3 text-xs font-medium text-muted-foreground hover:bg-accent">Cancelar</button>
                                                                            <button type="submit" class="shrink-0 bg-primary text-primary-foreground hover:bg-primary/90 h-8 rounded-md px-3 text-xs font-medium">Guardar</button>
                                                                        </div>
                                                                    </div>
                                                                </form>
                                                            }
                                                            <p class="text-[10px] text-muted-foreground mt-1"><time class="local-time" datetime="@reply.CreatedAt.ToString("O")">@reply.CreatedAt.ToString("g")</time></p>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="flex flex-col items-center justify-center rounded-2xl border border-dashed p-8 text-center text-sm text-muted-foreground bg-card/50">
                    <i data-lucide="image" class="mb-3 size-8 opacity-20"></i>
                    @if (!string.IsNullOrEmpty(Model.SearchQuery) || Model.FilterMediaType.HasValue || Model.FilterDateFrom.HasValue || Model.FilterDateTo.HasValue || (Model.FilterEditState.HasValue && Model.FilterEditState.Value != 0) || !string.IsNullOrEmpty(Model.FriendUsername))
                    {
                        <p class="font-medium text-foreground">No se encontraron publicaciones que coincidan con los criterios seleccionados.</p>
                    }
                    else
                    {
                        <p class="font-medium text-foreground">Sus amigos todavía no han realizado publicaciones disponibles para usted.</p>
                    }
                </div>
            }
        </div>
    </div>
</div>
