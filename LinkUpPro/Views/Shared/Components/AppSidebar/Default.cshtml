@model AppSidebarViewModel

@{
    var currentUrl = ViewContext.HttpContext.Request.Path.ToString().ToLower();
    var profilePic = Model.CurrentUser?.ProfilePictureUrl ?? "/placeholder.svg";
    var unreadCount = Model.UnreadNotificationsCount;
    var pendingRequestsCount = Model.PendingFriendRequestsCount;
}

<aside class="sticky top-0 hidden h-screen w-60 shrink-0 flex-col border-r border-border bg-sidebar px-4 py-5 md:flex xl:w-72">
    <a href="/" class="mb-6 flex items-center gap-2 px-2">
        <div class="flex items-center justify-center rounded-lg bg-primary p-1.5 text-primary-foreground">
            <i data-lucide="network" class="size-5 text-white fill-current"></i>
        </div>
        <span class="text-lg font-bold tracking-tight">
            LinkUp <span class="text-primary">Pro</span>
        </span>
    </a>

    <nav class="flex flex-1 flex-col gap-1">
        <a href="/" class="group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors @(currentUrl == "/" || currentUrl == "/home" ? "bg-sidebar-accent text-sidebar-accent-foreground" : "text-muted-foreground hover:bg-sidebar-accent/60 hover:text-sidebar-accent-foreground")">
            <i data-lucide="home" class="size-5 shrink-0"></i>
            <span class="flex-1 truncate">Inicio</span>
        </a>
        <a href="/Friendship/Index" class="group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors @(currentUrl.StartsWith("/friendship") ? "bg-sidebar-accent text-sidebar-accent-foreground" : "text-muted-foreground hover:bg-sidebar-accent/60 hover:text-sidebar-accent-foreground")">
            <i data-lucide="users" class="size-5 shrink-0"></i>
            <span class="flex-1 truncate">Amigos</span>
        </a>
        <a href="/FriendRequest/Index" class="group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors @(currentUrl.StartsWith("/friendrequest") ? "bg-sidebar-accent text-sidebar-accent-foreground" : "text-muted-foreground hover:bg-sidebar-accent/60 hover:text-sidebar-accent-foreground")">
            <i data-lucide="user-plus" class="size-5 shrink-0"></i>
            <span class="flex-1 truncate">Solicitudes</span>
            @if (pendingRequestsCount > 0)
            {
                <span class="flex h-5 min-w-5 items-center justify-center rounded-full bg-primary px-1.5 text-[10px] font-medium text-primary-foreground">@pendingRequestsCount</span>
            }
        </a>
        <a href="/Notification/Index" class="group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors @(currentUrl.StartsWith("/notification") ? "bg-sidebar-accent text-sidebar-accent-foreground" : "text-muted-foreground hover:bg-sidebar-accent/60 hover:text-sidebar-accent-foreground")">
            <i data-lucide="bell" class="size-5 shrink-0"></i>
            <span class="flex-1 truncate">Notificaciones</span>
            @if (unreadCount > 0)
            {
                <span class="flex h-5 min-w-5 items-center justify-center rounded-full bg-destructive px-1.5 text-[10px] font-medium text-destructive-foreground">@unreadCount</span>
            }
        </a>
        <a href="/Battleship/Index" class="group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors @(currentUrl.StartsWith("/battleship") ? "bg-sidebar-accent text-sidebar-accent-foreground" : "text-muted-foreground hover:bg-sidebar-accent/60 hover:text-sidebar-accent-foreground")">
            <i data-lucide="ship" class="size-5 shrink-0"></i>
            <span class="flex-1 truncate">Battleship</span>
        </a>

        <a href="/User/Profile" class="group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors @(currentUrl.StartsWith("/user/profile") ? "bg-sidebar-accent text-sidebar-accent-foreground" : "text-muted-foreground hover:bg-sidebar-accent/60 hover:text-sidebar-accent-foreground")">
            <i data-lucide="user" class="size-5 shrink-0"></i>
            <span class="flex-1 truncate">Perfil</span>
        </a>

    </nav>

    <form asp-controller="Auth" asp-action="Logout" method="post" class="mb-2">
        <button type="submit" class="w-full flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-sidebar-accent/60 hover:text-sidebar-accent-foreground">
            <i data-lucide="log-out" class="size-5 shrink-0"></i>
            <span>Cerrar sesión</span>
        </button>
    </form>

    <div class="mt-4 flex items-center gap-3 rounded-2xl border border-border bg-card p-2.5">
        <div class="relative flex size-10 shrink-0 overflow-hidden rounded-full">
            <img class="aspect-square h-full w-full object-cover" src="@profilePic" alt="Avatar" onerror="this.src='/placeholder.svg'" />
        </div>
        <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-semibold">@User.Identity?.Name</p>
            <p class="truncate text-xs text-muted-foreground">
                @@@(User.Identity?.Name)
            </p>
        </div>
        <button onclick="toggleTheme()" class="inline-flex h-9 w-9 items-center justify-center rounded-md bg-transparent text-muted-foreground transition-colors hover:bg-accent hover:text-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring shrink-0" aria-label="Cambiar tema">
            <span class="theme-icon-sun" style="display: none;"><i data-lucide="sun" class="size-5"></i></span>
            <span class="theme-icon-moon"><i data-lucide="moon" class="size-5"></i></span>
        </button>
    </div>
</aside>

<script src="~/js/appsidebar-default.js" asp-append-version="true"></script>
