@{
    ViewData["Title"] = "Registro Exitoso";
    Layout = "_AuthLayout";
}

<div class="flex flex-col gap-6 w-full animate-in fade-in slide-in-from-bottom-4 duration-500 text-center">
    <div class="flex flex-col items-center gap-4">
        <div class="bg-primary/10 text-primary p-4 rounded-full">
            <i data-lucide="mail-check" class="size-12"></i>
        </div>
        <h1 class="text-3xl font-bold tracking-tight text-foreground">¡Cuenta creada!</h1>
        <p class="text-muted-foreground font-medium max-w-sm">
            Hemos enviado un enlace de activación a tu correo electrónico. Por favor, haz clic en el enlace para activar tu cuenta.
        </p>
    </div>

    <div class="flex flex-col gap-3 mt-4">
        <a href="/Auth/Index" class="inline-flex items-center justify-center whitespace-nowrap transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 w-full rounded-full h-11 text-base font-medium">
            Volver a iniciar sesión
        </a>
        <p class="text-sm text-muted-foreground mt-2">
            ¿No lo recibiste? 
            <a href="/Auth/ResendActivation" class="font-bold text-primary hover:underline">
                Reenviar correo
            </a>
        </p>
    </div>
</div>
