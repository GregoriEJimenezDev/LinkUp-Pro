@{ Layout = "_AuthLayout"; 
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="flex flex-col gap-6 w-full animate-in fade-in slide-in-from-bottom-4 duration-500">
    <div class="flex flex-col gap-2">
        <div class="flex items-center gap-2 text-primary font-bold text-xl mb-4">
            <div class="flex items-center justify-center">
                <span class="bg-primary text-primary-foreground font-bold px-2 py-1 rounded">in</span>
            </div>
            <span>LinkUp Pro</span>
        </div>
        <h1 class="text-3xl font-bold tracking-tight text-foreground">Recupera tu cuenta</h1>
        <p class="text-muted-foreground font-medium">Ingresa tu nombre de usuario y te enviaremos un enlace para restablecer tu contraseña.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="flex items-start gap-3 rounded-lg border border-emerald-500/30 bg-emerald-500/10 p-4 text-sm text-emerald-400">
            <i data-lucide="check-circle" class="size-5 mt-0.5 shrink-0"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    <form asp-controller="Auth" asp-action="ForgotPassword" method="post" class="flex flex-col gap-5 mt-2" onsubmit="disableSubmitButton(this)">

        <div class="grid gap-2">
            <label for="username" class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Nombre de usuario</label>
            <div class="relative">
                <i data-lucide="user" class="absolute left-3 top-2.5 size-5 text-muted-foreground"></i>
                <input id="username" name="username" type="text" placeholder="tunombredeusuario" required class="pl-10 h-11 bg-muted/40 border-transparent focus-visible:bg-transparent flex w-full rounded-md border border-input px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" />
            </div>
        </div>

        <button type="submit" class="inline-flex items-center justify-center whitespace-nowrap transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 w-full rounded-full h-11 mt-2 text-base font-medium">
            Enviar enlace
            <i data-lucide="send" class="ml-2 size-4"></i>
        </button>
    </form>

    <p class="text-center text-sm text-muted-foreground mt-4">
        <a href="/Auth/Index" class="font-bold text-primary hover:underline inline-flex items-center gap-1">
            <i data-lucide="arrow-left" class="size-4"></i>
            Volver a iniciar sesión
        </a>
    </p>

    <script>
        function disableSubmitButton(form) {
            if (window.jQuery && !$(form).valid()) {
                return;
            }
            const btn = form.querySelector('button[type="submit"]');
            if (btn) {
                btn.disabled = true;
                btn.classList.add('opacity-50', 'pointer-events-none');
                btn.innerHTML = 'Enviando enlace... <i class="ml-2 size-4 animate-spin" data-lucide="loader-2"></i>';
                if (window.lucide) {
                    lucide.createIcons();
                }
            }
        }
    </script>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
