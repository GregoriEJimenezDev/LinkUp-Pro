@model ResetPasswordViewModel

@{
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="flex flex-col gap-6 w-full animate-in fade-in slide-in-from-bottom-4 duration-500">
    <div class="flex flex-col gap-2">
        <div class="flex items-center gap-2 text-primary font-bold text-xl mb-4">
            <div class="flex items-center justify-center">
                <span class="bg-primary text-primary-foreground font-bold px-2 py-1 rounded">in</span>
            </div>
            <span>LinkUp Pro</span>
        </div>
        <h1 class="text-3xl font-bold tracking-tight text-foreground">Nueva contraseña</h1>
        <p class="text-muted-foreground font-medium">Ingresa tu nueva contraseña para restablecer tu cuenta.</p>
    </div>

    <form asp-controller="Auth" asp-action="ResetPassword" method="post" class="flex flex-col gap-5 mt-2">

        <div asp-validation-summary="ModelOnly" class="text-destructive text-sm font-semibold"></div>

        <input asp-for="UserId" type="hidden" />
        <input asp-for="Token" type="hidden" />

        <div class="grid gap-2">
            <label asp-for="Password" class="text-foreground text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Nueva contraseña</label>
            <div class="relative">
                <i data-lucide="lock" class="absolute left-3 top-2.5 size-5 text-muted-foreground"></i>
                <input asp-for="Password" type="password" id="resetPassword" placeholder="Mínimo 8 caracteres" class="pl-10 pr-10 h-11 bg-muted/40 border-transparent focus-visible:bg-transparent flex w-full rounded-md border border-input px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" />
                <button type="button" onclick="togglePassword('resetPassword', this)" class="absolute right-3 top-2.5 text-muted-foreground hover:text-foreground">
                    <i data-lucide="eye" class="size-5"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-destructive text-sm"></span>

            <div id="strengthContainer" class="grid gap-2 mt-1 hidden">
                <div class="flex gap-1">
                    <div id="str-seg-1" class="h-1 flex-1 rounded-full bg-muted transition-colors duration-300"></div>
                    <div id="str-seg-2" class="h-1 flex-1 rounded-full bg-muted transition-colors duration-300"></div>
                    <div id="str-seg-3" class="h-1 flex-1 rounded-full bg-muted transition-colors duration-300"></div>
                </div>
                <p id="strengthText" class="text-[10px] font-medium text-muted-foreground"></p>
            </div>
        </div>

        <div class="grid gap-2">
            <label asp-for="ConfirmPassword" class="text-foreground text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Confirmar contraseña</label>
            <div class="relative">
                <i data-lucide="lock" class="absolute left-3 top-2.5 size-5 text-muted-foreground"></i>
                <input asp-for="ConfirmPassword" type="password" id="resetConfirmPassword" placeholder="Repite tu contraseña" class="pl-10 pr-10 h-11 bg-muted/40 border-transparent focus-visible:bg-transparent flex w-full rounded-md border border-input px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" />
                <button type="button" onclick="togglePassword('resetConfirmPassword', this)" class="absolute right-3 top-2.5 text-muted-foreground hover:text-foreground">
                    <i data-lucide="eye" class="size-5"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-destructive text-sm"></span>
        </div>

        <button type="submit" class="inline-flex items-center justify-center whitespace-nowrap transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 w-full rounded-full h-11 mt-2 text-base font-medium">
            Restablecer contraseña
            <i data-lucide="arrow-right" class="ml-2 size-4"></i>
        </button>
    </form>

    <p class="text-center text-sm text-muted-foreground mt-4">
        <a href="/Auth/Index" class="font-bold text-primary hover:underline inline-flex items-center gap-1">
            <i data-lucide="arrow-left" class="size-4"></i>
            Volver a iniciar sesión
        </a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/auth-resetpassword.js" asp-append-version="true"></script>
}
