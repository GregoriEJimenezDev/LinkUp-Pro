@{
    ViewData["Title"] = "Reenviar Activación";
    Layout = "_AuthLayout";
}

<div class="flex flex-col gap-6 w-full animate-in fade-in slide-in-from-bottom-4 duration-500">
    <div class="flex flex-col gap-2">
        <div class="flex items-center gap-2 text-primary font-bold text-xl mb-4">
            <div class="bg-primary text-primary-foreground p-1.5 rounded-md">
                <i data-lucide="mail-plus" class="size-5 text-white"></i>
            </div>
            <span>Reenviar correo</span>
        </div>
        <h1 class="text-3xl font-bold tracking-tight text-foreground">¿No recibiste el correo?</h1>
        <p class="text-muted-foreground font-medium">Ingresa tu usuario o correo electrónico y te enviaremos un nuevo enlace de activación.</p>
    </div>

    <form asp-controller="Auth" asp-action="ResendActivation" method="post" class="flex flex-col gap-5 mt-2" onsubmit="disableSubmitButton(this)">
        
        <div asp-validation-summary="ModelOnly" class="text-destructive text-sm font-semibold"></div>

        <div class="grid gap-2">
            <label for="username" class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Usuario o Correo electrónico</label>
            <div class="relative">
                <i data-lucide="user" class="absolute left-3 top-2.5 size-5 text-muted-foreground"></i>
                <input id="username" name="username" placeholder="tunombre o correo@ejemplo.com" required class="pl-10 h-11 bg-muted/40 border-transparent focus-visible:bg-transparent flex w-full rounded-md border border-input px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" />
            </div>
        </div>

        <button type="submit" class="inline-flex items-center justify-center whitespace-nowrap transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 w-full rounded-full h-11 mt-2 text-base font-medium">
            Reenviar enlace
            <i data-lucide="arrow-right" class="ml-2 size-4"></i>
        </button>
    </form>

    <p class="text-center text-sm text-muted-foreground mt-4">
        <a href="/Auth/Index" class="font-bold text-primary hover:underline inline-flex items-center">
            <i data-lucide="arrow-left" class="size-4 mr-1"></i>
            Volver a iniciar sesión
        </a>
    </p>
</div>

<script src="~/js/auth-resendactivation.js" asp-append-version="true"></script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
