@model int

@{
    ViewData["Title"] = "Confirmar Aceptación";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm mt-5">
            <div class="card-body text-center p-4">
                <i class="bi bi-person-check-fill text-success" style="font-size: 3rem;"></i>
                <h4 class="card-title mt-3">¿Aceptar solicitud?</h4>
                <p class="text-muted mb-4">Estás a punto de aceptar esta solicitud de amistad. Este usuario podrá ver tus publicaciones y podrán jugar juntos.</p>
                
                <form asp-action="Accept" method="post">
                    <input type="hidden" name="id" value="@Model" />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success">Aceptar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
