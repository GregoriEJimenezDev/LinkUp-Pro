@model int

@{
    ViewData["Title"] = "Confirmar Rechazo";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm mt-5">
            <div class="card-body text-center p-4">
                <i class="bi bi-person-x-fill text-danger" style="font-size: 3rem;"></i>
                <h4 class="card-title mt-3">¿Rechazar solicitud?</h4>
                <p class="text-muted mb-4">Estás a punto de rechazar esta solicitud de amistad. La solicitud seguirá en tu historial, pero no se agregará como amigo.</p>
                
                <form asp-action="Reject" method="post">
                    <input type="hidden" name="id" value="@Model" />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger">Rechazar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
