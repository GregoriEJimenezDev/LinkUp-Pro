@model int

@{
    ViewData["Title"] = "Cancelar Solicitud";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm mt-5">
            <div class="card-body text-center p-4">
                <i class="bi bi-x-circle-fill text-warning" style="font-size: 3rem;"></i>
                <h4 class="card-title mt-3">¿Cancelar solicitud enviada?</h4>
                <p class="text-muted mb-4">La solicitud pasará a estado Cancelada y permanecerá en tu historial, pero el destinatario ya no podrá aceptarla.</p>
                
                <form asp-action="Delete" method="post">
                    <input type="hidden" name="id" value="@Model" />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-warning text-dark">Cancelar Solicitud</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Atrás</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
