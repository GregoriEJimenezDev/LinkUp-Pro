@model int

@{
    ViewData["Title"] = "Ocultar del Historial";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm mt-5">
            <div class="card-body text-center p-4">
                <i class="bi bi-eye-slash-fill text-secondary" style="font-size: 3rem;"></i>
                <h4 class="card-title mt-3">¿Eliminar del historial?</h4>
                <p class="text-muted mb-4">Esta acción solo ocultará la solicitud de tu vista. El estado original de la solicitud se conserva.</p>
                
                <form asp-action="RemoveFromHistory" method="post">
                    <input type="hidden" name="id" value="@Model" />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-secondary">Ocultar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
